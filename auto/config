#!/bin/sh
# One Debian 13 base for all KythOS Kernal editions.
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
version=$(cat "$repo_root/VERSION")
if ! printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([.+~-][0-9A-Za-z.+~-]+)?$'; then
    echo 'VERSION must contain a valid release version.' >&2
    exit 2
fi

if test "$#" -ne 0; then
    echo 'Kernal base does not accept lb config overrides.' >&2
    exit 2
fi

lb config noauto \
    --ignore-system-defaults \
    --mode debian \
    --distribution trixie \
    --architecture amd64 \
    --system live \
    --binary-image iso-hybrid \
    --bootloaders 'syslinux,grub-efi' \
    --archive-areas 'main contrib non-free non-free-firmware' \
    --apt-secure true \
    --apt-recommends true \
    --apt-source-archives false \
    --security true \
    --updates true \
    --backports false \
    --firmware-chroot true \
    --firmware-binary true \
    --linux-flavours amd64 \
    --linux-packages linux-image \
    --debian-installer live \
    --debian-installer-distribution trixie \
    --debian-installer-gui true \
    --uefi-secure-boot enable \
    --source true \
    --source-images iso \
    --checksums sha256 \
    --utc-time true \
    --mirror-bootstrap 'https://deb.debian.org/debian/' \
    --mirror-chroot 'https://deb.debian.org/debian/' \
    --mirror-chroot-security 'https://security.debian.org/debian-security/' \
    --mirror-binary 'https://deb.debian.org/debian/' \
    --mirror-binary-security 'https://security.debian.org/debian-security/' \
    --mirror-debian-installer 'https://deb.debian.org/debian/' \
    --bootappend-live 'boot=live components audit=1 audit_backlog_limit=8192 hostname=kythos-live username=kythos-live locales=en_US.UTF-8 keyboard-layouts=us console=tty0 console=ttyS0,115200n8' \
    --iso-application 'KythOS Kernal' \
    --iso-publisher 'KythOS' \
    --iso-volume 'KYTHOS_KERNAL' \
    --image-name "kythos-kernal-base-${version}"
