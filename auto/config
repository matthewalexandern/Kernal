#!/bin/sh
# One Debian 13 base for all KythOS Kernal editions.
set -eu

repo_root=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd)
version=$(cat "$repo_root/VERSION")
if ! printf '%s\n' "$version" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+([.+~-][0-9A-Za-z.+~-]+)?$'; then
    echo 'VERSION must contain a valid release version.' >&2
    exit 2
fi
snapshot=$(cat "$repo_root/SNAPSHOT")
if ! printf '%s\n' "$snapshot" | grep -Eq '^[0-9]{8}T[0-9]{6}Z$'; then
    echo 'SNAPSHOT must contain a UTC snapshot.debian.org timestamp.' >&2
    exit 2
fi
snapshot_debian="https://snapshot.debian.org/archive/debian/$snapshot/"
snapshot_security="https://snapshot.debian.org/archive/debian-security/$snapshot/"
architecture=${KYTHOS_ARCH:-amd64}
profile_tool="$repo_root/config/includes.chroot/usr/local/libexec/kythos-architecture"
kernel_flavour=$("$profile_tool" --arch "$architecture" --get kernel_flavour)
bootloaders=$("$profile_tool" --arch "$architecture" --get bootloaders)
edition=${KYTHOS_EDITION:-base}
edition_tool="$repo_root/config/includes.chroot/usr/local/libexec/kythos-edition"
"$edition_tool" --edition "$edition" >/dev/null

if test "$#" -ne 0; then
    echo 'Kernal base does not accept lb config overrides.' >&2
    exit 2
fi

lb config noauto \
    --ignore-system-defaults \
    --mode debian \
    --distribution trixie \
    --architecture "$architecture" \
    --system live \
    --binary-image iso-hybrid \
    --bootloaders "$bootloaders" \
    --archive-areas 'main contrib non-free non-free-firmware' \
    --apt-secure true \
    --apt-options '--yes -o Acquire::Check-Valid-Until=false' \
    --apt-recommends true \
    --apt-source-archives false \
    --security true \
    --updates true \
    --backports false \
    --firmware-chroot false \
    --firmware-binary true \
    --linux-flavours "$kernel_flavour" \
    --linux-packages linux-image \
    --debian-installer live \
    --debian-installer-distribution trixie \
    --debian-installer-gui true \
    --uefi-secure-boot enable \
    --source true \
    --source-images iso \
    --checksums sha256 \
    --utc-time true \
    --mirror-bootstrap "$snapshot_debian" \
    --mirror-chroot "$snapshot_debian" \
    --mirror-chroot-security "$snapshot_security" \
    --mirror-binary 'https://deb.debian.org/debian/' \
    --mirror-binary-security 'https://security.debian.org/debian-security/' \
    --mirror-debian-installer "$snapshot_debian" \
    --bootappend-live 'boot=live components live-config.nocomponents=sudo,xinit quiet splash audit=1 audit_backlog_limit=8192 hostname=kythos-live username=kythos-live locales=en_US.UTF-8 keyboard-layouts=us console=tty0' \
    --iso-application 'KythOS Kernal' \
    --iso-publisher 'KythOS' \
    --iso-volume 'KYTHOS_KERNAL' \
    --image-name "kythos-kernal-${edition}-${version}"
