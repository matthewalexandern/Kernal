#!/bin/sh
set -eu

# The advanced installer owns partitioning, accounts and boot setup. Remove the
# fixed live package closure and custom files after those native steps, before
# the stock 95umount component detaches /target.
if test -x /target/usr/local/libexec/kythos-calamares-clean-live-files; then
    in-target /usr/local/libexec/kythos-calamares-clean-live-files
fi

# Never copy a live/build host identity into the installed machine. Missing
# host keys are generated by ssh.service on the first installed boot.
for key in /target/etc/ssh/ssh_host_*_key*; do
    if test -f "$key" || test -L "$key"; then
        rm -f "$key"
    fi
done
in-target /usr/local/sbin/kythos-enable-ssh --offline
if test "$(in-target /usr/bin/systemctl is-enabled ssh.service)" != enabled; then
    printf '%s\n' 'KythOS Kernal failed to enable installed SSH access.' >&2
    exit 1
fi

# The copied live filesystem defaults to graphical.target so it can start the
# temporary installer UI. The installed common base must start at a terminal,
# matching the Calamares finalizer and avoiding a dead graphical boot after
# the live X/Qt packages are removed.
installed_target=$(in-target /usr/local/libexec/kythos-edition --get default_target)
case "$installed_target" in multi-user.target|graphical.target) ;; *) exit 1 ;; esac
if test "$installed_target" = graphical.target; then
    in-target /usr/bin/systemctl enable lightdm.service
fi
in-target /usr/bin/systemctl set-default "$installed_target"
if test "$(in-target /usr/bin/systemctl get-default)" != "$installed_target"; then
    printf '%s\n' 'KythOS Kernal failed to set the installed edition target.' >&2
    exit 1
fi
