#!/bin/sh
set -eu

if test "$#" -ne 2; then
    printf 'Usage: %s INPUT OUTPUT\n' "$0" >&2
    exit 2
fi

input=$1
output=$2

test -f "$input"

# Only the display fields of templates that identify this installer or the
# installed operating system are branded. Template names, machine-readable
# choices, defaults, repository names, URLs, and Debian archive provenance
# remain byte-for-byte unchanged.
awk '
function carries_kythos_identity(name) {
    return name == "debian-installer/main-menu-title" \
        || name == "debian-installer/terminal-plugin-unavailable" \
        || name == "cdrom-checker/askmount" \
        || name == "cdrom-checker/wrongcd" \
        || name == "cdrom-checker/firstcd" \
        || name == "cdrom/suite" \
        || name == "apt-setup/local/key-error" \
        || name == "grub-installer/only_debian" \
        || name == "grub-installer/with_other_os" \
        || name == "grub-installer/update-nvram" \
        || name == "netcfg/use_autoconfig" \
        || name == "netcfg/choose_interface" \
        || name == "netcfg/no_default_route" \
        || name == "network-console/login" \
        || name == "network-console/password" \
        || name == "nobootloader/confirmation_powerpc_chrp_pegasos" \
        || name == "nobootloader/confirmation_powerpc_pasemi" \
        || name == "partman-auto/help" \
        || name == "partman-auto/init_automatically_partition" \
        || name == "partman/confirm_nochanges" \
        || name == "partman-crypto/tools_missing" \
        || name == "partman-efi/non_efi_system" \
        || name == "partman-target/help" \
        || name == "partman-target/arch_help/i386/generic" \
        || name == "partman-target/arch_help/powerpc/powermac_newworld" \
        || name == "passwd/make-user"
}

function identifier_character(character) {
    # Machine identifiers use ASCII; adjacent Chinese/Japanese/Korean prose
    # must not be mistaken for part of an identifier containing the old name.
    return character ~ /^[A-Za-z0-9_]$/
}

function protected_token(value, position, width, start, finish, token, lower) {
    start = position
    while (start > 1 && substr(value, start - 1, 1) !~ /[[:space:]]/)
        start--
    finish = position + width
    while (finish <= length(value) \
           && substr(value, finish, 1) !~ /[[:space:]]/)
        finish++

    token = substr(value, start, finish - start)
    lower = tolower(token)
    return index(token, "${") \
        || index(token, "/") \
        || index(token, "\\") \
        || index(token, "@") \
        || lower ~ /^(https?|ftp|file|mailto):/ \
        || token ~ /[[:alnum:]-]+\.[[:alnum:]-]+/
}

# Reviewed Latin inflections in the shipped installer translations. Removing
# the grammatical suffix keeps the product name itself exactly KythOS Kernal.
# Unknown identifiers remain protected rather than guessing at their meaning.
function inflection_width(value, position, tail, suffix) {
    tail = substr(value, position)
    if (substr(tail, 1, length("ê")) == "ê" \
        && !identifier_character(substr(tail, length("ê") + 1, 1)))
        return length("ê")
    if (!match(tail, /^[A-Za-z]+/))
        return 0
    suffix = tolower(substr(tail, 1, RLENGTH))
    if (suffix ~ /^(a|aj|an|em|i|in|iin|o|on|ov|ovih|ovog|ovom|s|u)$/)
        return RLENGTH
    return 0
}

function replace_identity(value, result, position, width, fragment, before, after, suffix, separator, installer) {
    result = ""
    position = 1
    while (position <= length(value)) {
        width = 0
        installer = 0
        fragment = tolower(substr(value, position, 16))
        if (fragment == "debian-installer" \
            || fragment == "debian installer") {
            width = 16
            installer = 1
        } else if (tolower(substr(value, position, 6)) == "debian")
            width = 6

        if (width) {
            before = position > 1 ? substr(value, position - 1, 1) : ""
            suffix = inflection_width(value, position + width)
            separator = ""
            # Swedish translations join the old name to the noun system.
            # Keep that noun readable without joining it to our product name.
            if (tolower(substr(value, position + width)) \
                ~ /^system(et)?([^A-Za-z0-9_]|$)/)
                separator = " "
            width += suffix
            after = substr(value, position + width, 1)
            # Some translated words begin like English installer (for example
            # Swedish installeras and Norwegian installeringsmediet). In that
            # case replace just the product name and leave the local noun.
            if (installer && identifier_character(after) && separator == "") {
                width = 6 + inflection_width(value, position + 6)
                installer = 0
                after = substr(value, position + width, 1)
            }
            if (identifier_character(before) \
                || (identifier_character(after) && separator == "") \
                || protected_token(value, position, width))
                width = 0
        }

        if (width) {
            if (installer)
                result = result "KythOS Kernal installer"
            else
                result = result "KythOS Kernal"
            result = result separator
            position += width
        } else {
            result = result substr(value, position, 1)
            position++
        }
    }
    return result
}

/^Template:[[:space:]]*/ {
    template = $0
    sub(/^Template:[[:space:]]*/, "", template)
    in_description = 0
}

{
    if ($0 ~ /^Description([-.][^:]*)?:/) {
        in_description = 1
    } else if ($0 !~ /^[[:space:]]/) {
        in_description = 0
    }

    if (carries_kythos_identity(template) && in_description)
        print replace_identity($0)
    else
        print
}
' "$input" > "$output"
