/* KythOS Kernal — native Calamares 3.3 styling.
 * Calamares loads this file from the branding directory.
 * Keep native controls, focus, warnings, and disabled states visible.
 * SPDX-License-Identifier: MIT
 */

QWidget {
    background-color: #0b0b0b;
    color: #ffffff;
    font-family: "DejaVu Sans";
    font-size: 13px;
    selection-background-color: #ffffff;
    selection-color: #080808;
}
QWidget#sidebarApp {
    background-color: #080808;
    border-right: 1px solid #383838;
}
QWidget#sidebarApp QLabel, QWidget#sidebarApp QListView {
    background-color: transparent; border: none;
}
QLabel#logoApp { margin-top: 10px; margin-bottom: 10px; }
QLabel { background-color: transparent; }
QLabel:disabled { color: #969696; }
QLabel#mainText { color: #ffffff; font-size: 18px; }
QLabel#summaryTitle { color: #c8c8c8; padding: 12px 0; }
QLabel#summaryItemTitle {
    color: #ffffff; font-size: 22px; font-weight: 500; padding: 10px 0 4px 0;
}
QLabel#summaryItemBody {
    background-color: #171717; border: 1px solid #3c3c3c;
    border-radius: 7px; padding: 10px;
}
QWidget#kythosPartitionChoice {
    background-color: #171717; border: 1px solid #3c3c3c; border-radius: 7px;
}
QWidget#kythosPartitionChoice:hover { background-color: #242424; border-color: #777777; }
QWidget#kythosPartitionChoice > QWidget { background-color: transparent; }
QWidget#kythosPartitionChoice QLabel { color: #dedede; }
QWidget#kythosPartitionChoice QRadioButton:focus {
    background-color: #2e2e2e; border: 1px solid #ffffff; border-radius: 4px;
}
QLabel#m_messageLabel { color: #c8c8c8; padding: 4px 0 8px 0; }
QLabel#m_drivesLabel { color: #ededed; }
QLabel#bootInfoLabel, QLabel#deviceInfoLabel, QLabel#mountPointExplanation { color: #c8c8c8; }
QLabel#labelFullNameError, QLabel#labelUsernameError, QLabel#labelHostnameError,
QLabel#labelUserPasswordError, QLabel#labelRootPasswordError { color: #ffb5b5; }
QLabel#kythosStorageWarning {
    color: #ffdda5; background-color: #322919;
    border: 1px solid #8b6a37; border-radius: 5px; padding: 9px;
}

QPushButton, QToolButton {
    color: #ffffff; background-color: #252525;
    border: 1px solid #666666; border-radius: 5px;
    padding: 7px 10px; min-height: 16px;
}
QPushButton:hover, QToolButton:hover { background-color: #333333; border-color: #dddddd; }
QPushButton:pressed, QToolButton:pressed { background-color: #1a1a1a; border-color: #ffffff; }
QPushButton:focus, QToolButton:focus { border: 2px solid #ffffff; padding: 6px 9px; }
QPushButton:default, QPushButton#view-button-next, QPushButton#view-button-done {
    background-color: #ffffff; color: #080808; border-color: #ffffff; font-weight: 600;
}
QPushButton:default:hover, QPushButton#view-button-next:hover,
QPushButton#view-button-done:hover { background-color: #e5e5e5; border-color: #e5e5e5; }
QPushButton:default:focus, QPushButton#view-button-next:focus,
QPushButton#view-button-done:focus { border-color: #ffffff; }
QPushButton#view-button-back, QPushButton#view-button-next, QPushButton#view-button-cancel {
    min-width: 72px; padding: 8px 16px; border-radius: 6px;
}
QPushButton#view-button-back:focus, QPushButton#view-button-next:focus,
QPushButton#view-button-cancel:focus { padding: 7px 15px; }
QPushButton:disabled, QToolButton:disabled,
QPushButton#view-button-next:disabled, QPushButton#view-button-done:disabled {
    color: #969696; background-color: #1a1a1a; border: 1px solid #3e3e3e;
}
QPushButton#aboutButton {
    background-color: transparent; color: #c8c8c8; border-color: transparent; margin: 8px;
}
QPushButton#aboutButton:hover, QPushButton#aboutButton:focus { color: #ffffff; border-color: #666666; }

QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateTimeEdit {
    background-color: #060606; color: #ffffff;
    border: 1px solid #666666; border-radius: 4px;
    padding: 5px 8px; min-height: 18px; placeholder-text-color: #b8b8b8;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus,
QDoubleSpinBox:focus, QDateTimeEdit:focus { border-color: #ffffff; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled,
QDoubleSpinBox:disabled, QDateTimeEdit:disabled {
    color: #969696; background-color: #1a1a1a; border-color: #3e3e3e;
}
QLineEdit[readOnly="true"] { color: #c8c8c8; }
QComboBox { padding-right: 26px; }
QComboBox::drop-down {
    width: 23px; border-left: 1px solid #666666;
    border-top-right-radius: 4px; border-bottom-right-radius: 4px;
    background-color: #252525;
}
QComboBox::drop-down:hover { background-color: #333333; }
QComboBox::down-arrow {
    image: url(/etc/calamares/branding/kythos/chevron.svg);
    width: 16px; height: 16px;
}
QComboBox QAbstractItemView {
    color: #ffffff; background-color: #171717;
    selection-background-color: #ffffff; selection-color: #080808;
    border: 1px solid #777777; padding: 4px; outline: 0;
}
QSpinBox::up-button, QDoubleSpinBox::up-button,
QSpinBox::down-button, QDoubleSpinBox::down-button {
    width: 20px; background-color: #252525; border-left: 1px solid #666666;
}
QSpinBox::up-button:hover, QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover, QDoubleSpinBox::down-button:hover { background-color: #3e3e3e; }
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(/etc/calamares/branding/kythos/chevron-up.svg);
    width: 12px; height: 12px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(/etc/calamares/branding/kythos/chevron.svg);
    width: 12px; height: 12px;
}
QSpinBox, QDoubleSpinBox { padding-right: 24px; }

QCheckBox, QRadioButton { spacing: 8px; padding: 3px 0; }
QCheckBox:focus, QRadioButton:focus {
    color: #ffffff; background-color: #112638; border-radius: 3px;
}
QCheckBox:disabled, QRadioButton:disabled { color: #969696; }
QCheckBox::indicator, QRadioButton::indicator { width: 17px; height: 17px; }
QCheckBox::indicator {
    background-color: #060606; border: 1px solid #57748c; border-radius: 3px;
}
QCheckBox::indicator:checked {
    image: url(/etc/calamares/branding/kythos/check.svg);
    border-color: #ffffff; background-color: #ffffff;
}
QCheckBox::indicator:indeterminate { background-color: #7edce6; border-color: #ffffff; }
QCheckBox::indicator:disabled { background-color: #1a1a1a; border-color: #666666; }
QCheckBox::indicator:checked:disabled { image: none; background-color: #6d899b; }
QRadioButton::indicator {
    background-color: #060606; border: 1px solid #57748c; border-radius: 9px;
}
QRadioButton::indicator:checked {
    background-color: #ffffff; border: 4px solid #204d60; border-radius: 9px;
}
QRadioButton::indicator:disabled { background-color: #1a1a1a; border-color: #666666; }
QRadioButton::indicator:checked:disabled { background-color: #6d899b; }

QAbstractItemView, QTextEdit, QPlainTextEdit, QTextBrowser {
    color: #ffffff; background-color: #060606; alternate-background-color: #101e2e;
    border: 1px solid #2e435a; border-radius: 4px;
    selection-background-color: #ffffff; selection-color: #080808;
}
QAbstractItemView::item { padding: 4px 5px; }
QAbstractItemView::item:hover { background-color: #2e2e2e; }
QAbstractItemView::item:selected { background-color: #ffffff; color: #080808; }
QAbstractItemView::indicator {
    width: 13px; height: 13px;
    background-color: #060606; border: 1px solid #57748c; border-radius: 3px;
}
QAbstractItemView::indicator:checked {
    image: url(/etc/calamares/branding/kythos/check.svg);
    background-color: #ffffff; border-color: #ffffff;
}
QAbstractItemView:focus, QTextEdit:focus, QPlainTextEdit:focus { border-color: #ffffff; }
QHeaderView, QHeaderView::section, QTableCornerButton::section {
    background-color: #252525; color: #d0dfeb; border: none;
}
QHeaderView::section { padding: 7px 6px; border-right: 1px solid #30465c; border-bottom: 1px solid #30465c; }
QTreeView::branch { background-color: transparent; }

QScrollArea { border: none; background-color: #0b0b0b; }
QScrollBar:vertical { background: #0b0b0b; width: 10px; margin: 0; }
QScrollBar:horizontal { background: #0b0b0b; height: 10px; margin: 0; }
QScrollBar::handle:vertical { background: #405b73; min-height: 25px; border-radius: 4px; }
QScrollBar::handle:horizontal { background: #405b73; min-width: 25px; border-radius: 4px; }
QScrollBar::handle:hover { background: #6185a0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: transparent; }

QGroupBox { border: 1px solid #2e435a; border-radius: 6px; margin-top: 13px; padding: 12px; }
QGroupBox::title { subcontrol-origin: margin; left: 10px; padding: 0 5px; }
QTabWidget::pane { border: 1px solid #2e435a; border-radius: 5px; }
QTabBar::tab { background: #101e2e; color: #c8c8c8; padding: 9px 14px; border: 1px solid #2e435a; }
QTabBar::tab:selected { background: #2e2e2e; color: #ffffff; }
QTabBar::tab:focus { border-color: #ffffff; }
QProgressBar {
    border: 1px solid #2e435a; border-radius: 5px; background-color: #060606;
    color: #ffffff; text-align: center; min-height: 20px;
}
QProgressBar::chunk { background-color: #008da2; border-radius: 4px; }
QSlider::groove:horizontal { height: 5px; background: #666666; border-radius: 2px; }
QSlider::handle:horizontal { background: #ffffff; width: 15px; margin: -5px 0; border-radius: 7px; }
QSlider:focus { background-color: #112638; }

QMenu, QToolTip { color: #ffffff; background-color: #171717; border: 1px solid #777777; padding: 6px; }
QMenu::item { padding: 7px 24px 7px 12px; }
QMenu::item:selected { background-color: #ffffff; color: #080808; }
QMenu::item:disabled { color: #969696; }
QMenu::separator { height: 1px; background-color: #666666; margin: 4px; }
QDialog, QMessageBox { background-color: #0b0b0b; }
QDialogButtonBox { background-color: transparent; }
QFrame[frameShape="4"], QFrame[frameShape="5"] { color: #3c3c3c; }

/* The patched native label painter uses this widget's Text and Base palette.
 * ChoicePage keeps the constructor's partitionLabel object name;
 * PartitionPage.ui replaces it with partitionLabelsView. Match the class
 * and both names, including their viewport children.
 */
PartitionLabelsView, PartitionLabelsView QWidget,
QAbstractItemView#partitionLabel, QAbstractItemView#partitionLabel QWidget,
QAbstractItemView#partitionLabelsView, QAbstractItemView#partitionLabelsView QWidget {
    background-color: #060606; color: #ffffff; border: none; border-radius: 3px;
}
