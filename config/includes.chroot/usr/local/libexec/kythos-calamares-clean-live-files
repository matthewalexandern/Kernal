#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""File-only cleanup for the advanced installer's already configured target.

This does not change packages, users, disks, encryption or boot configuration.
The advanced installer owns all those steps itself.
"""
from pathlib import Path
import runpy
import sys


def main():
    try:
        if len(sys.argv) != 1:
            raise ValueError("This helper takes no arguments.")
        helpers = runpy.run_path("/usr/local/libexec/kythos-calamares-target")
        helpers["verify_chroot_context"]()
        helpers["remove_live_files"]()
        Path("/usr/local/libexec/kythos-calamares-target").unlink(missing_ok=True)
        Path("/usr/local/libexec/kythos-calamares-grub-install").unlink(missing_ok=True)
    except (OSError, ValueError) as error:
        print("KythOS Kernal live-file cleanup failed: " + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
