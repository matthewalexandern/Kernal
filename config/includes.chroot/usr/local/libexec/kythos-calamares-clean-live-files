#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Remove the live environment from an advanced installer's configured target.

The advanced installer owns users, disks, encryption and boot configuration.
This helper removes only the build-time package closure and files recorded for
the live environment, using the same guarded target helpers as Calamares.
"""
from pathlib import Path
import runpy
import subprocess
import sys


def main():
    try:
        if len(sys.argv) != 1:
            raise ValueError("This helper takes no arguments.")
        helpers = runpy.run_path("/usr/local/libexec/kythos-calamares-target")
        helpers["verify_chroot_context"]()
        helpers["purge_live_packages"]()
        helpers["remove_live_files"]()
        Path("/usr/local/libexec/kythos-calamares-target").unlink(missing_ok=True)
        Path("/usr/local/libexec/kythos-calamares-grub-install").unlink(missing_ok=True)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print("KythOS Kernal live-environment cleanup failed: " + str(error), file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
