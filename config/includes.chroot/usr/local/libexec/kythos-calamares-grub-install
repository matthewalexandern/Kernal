#!/usr/bin/python3
# SPDX-License-Identifier: MIT
"""Adapt native Calamares GRUB calls to Debian's signed boot installation.

Debian grub-install maintains shim, signed GRUB, MokManager, fallback files,
and the vendor redirect grub.cfg. We keep this machinery intact and never
copy a raw GRUB image over the removable-path shim.
"""
import os
import json
from pathlib import Path
import re
import subprocess
import sys


def architecture_profile(architecture=None):
    arguments = [str(Path(__file__).with_name("kythos-architecture"))]
    if architecture is not None:
        arguments += ["--arch", architecture]
    return json.loads(subprocess.check_output(arguments, text=True))


def grub_arguments(arguments, architecture=None):
    selected = architecture_profile(architecture)
    efi_target = "--target=" + selected["efi_target"]
    if arguments == [efi_target, "--efi-directory=/boot/efi",
                     "--bootloader-id=kythos", "--force"]:
        return [efi_target, "--efi-directory=/boot/efi",
                "--bootloader-id=kythos", "--recheck", "--uefi-secure-boot",
                "--force-extra-removable"]
    if (selected["bios_target"] == "i386-pc" and len(arguments) == 4 and arguments[:3] ==
            ["--target=i386-pc", "--recheck", "--force"] and
            re.fullmatch(r"/dev/[A-Za-z0-9_./+-]+", arguments[3]) and
            "/../" not in arguments[3]):
        # Refuse embedding by force. Ordinary whole disks and a BIOS boot
        # partition work without it; unsafe blocklists should fail clearly.
        return ["--target=i386-pc", "--recheck", arguments[3]]
    raise ValueError("Unexpected Calamares bootloader arguments.")


def main():
    try:
        arguments = grub_arguments(sys.argv[1:])
        selected = architecture_profile()
        if "--target=" + selected["efi_target"] in arguments:
            suffix, platform = selected["efi_suffix"], selected["efi_target"]
            for name in (f"/usr/lib/shim/shim{suffix}.efi.signed",
                         f"/usr/lib/grub/{platform}-signed/grub{suffix}.efi.signed"):
                if not Path(name).is_file():
                    raise ValueError("A required signed EFI boot component is missing.")
        os.execv("/usr/sbin/grub-install", ["/usr/sbin/grub-install", *arguments])
    except (OSError, ValueError) as error:
        print(str(error), file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
