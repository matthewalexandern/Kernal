#!/bin/sh
set -eu
umask 077

config_dir=/etc/ssl/kythos
module_config=$config_dir/fipsmodule.cnf
openssl_config=$config_dir/openssl-fips.cnf
module=$(find /usr/lib -type f -path '*/ossl-modules/fips.so' -print -quit)

if test -z "$module"; then
    printf '%s\n' 'OpenSSL FIPS provider module is missing.' >&2
    exit 1
fi
test -r "$openssl_config"

install -d -m 0755 "$config_dir"
new_module_config=$(mktemp "$config_dir/.fipsmodule.cnf.XXXXXX")
test_config=$(mktemp "$config_dir/.openssl-fips.cnf.XXXXXX")
cleanup()
{
    rm -f -- "$new_module_config" "$test_config"
}
trap cleanup EXIT HUP INT TERM

# OpenSSL 3.5 requires -pedantic to enable all strict FIPS runtime checks in
# the generated provider configuration.
openssl fipsinstall \
    -pedantic \
    -module "$module" \
    -out "$new_module_config" \
    -provider_name fips >/dev/null
openssl fipsinstall \
    -verify \
    -module "$module" \
    -in "$new_module_config" >/dev/null

# Exercise the generated file before replacing the active copy. The separate
# OpenSSL configuration remains opt-in and never changes system-wide policy.
sed "s|/etc/ssl/kythos/fipsmodule.cnf|$new_module_config|" \
    "$openssl_config" > "$test_config"
providers=$(OPENSSL_CONF="$test_config" openssl list -providers)
provider_is_active() {
    printf '%s\n' "$providers" | awk -v wanted="$1" '
        /^[[:space:]]+[[:alnum:]_-]+[[:space:]]*$/ { provider = $1 }
        provider == wanted &&
            /^[[:space:]]+status:[[:space:]]+active[[:space:]]*$/ { active = 1 }
        END { exit(active ? 0 : 1) }
    '
}
provider_is_active fips
provider_is_active base
if provider_is_active default; then
    printf '%s\n' 'The default OpenSSL provider was activated unexpectedly.' >&2
    exit 1
fi
OPENSSL_CONF="$test_config" \
    openssl dgst -propquery 'fips=yes' -sha256 /dev/null >/dev/null

chmod 0644 "$new_module_config"
mv -f -- "$new_module_config" "$module_config"
trap - EXIT HUP INT TERM
rm -f -- "$test_config"
