#!/usr/bin/python3 -I
"""Local command proposals. Never execute a proposed command or read history."""

import gzip
import argparse
import json
import os
from pathlib import Path
import re
import shlex
import stat
import sys
import subprocess
import tempfile
import unicodedata


CATALOGUE = Path('/usr/share/kythos/command-intents.json')
COMMAND_INDEX = Path('/var/cache/kythos/command-index.json')
MAN_ROOT = Path('/usr/share/man')
MAX_MAN_BYTES = 2 * 1024 * 1024
MAX_INDEX_BYTES = 64 * 1024 * 1024
MAX_INPUT_BYTES = 4096
MAX_TOKENS = 64
MAX_TOKEN_LENGTH = 256
MAX_PATH_DIRECTORIES = 128
MAX_DIRECTORY_ENTRIES = 65536
MAX_COMMANDS = 65536
MAX_CONTEXT_BYTES = 131072
SLOT = re.compile(r'^\{([a-z][a-z_]*)(\.\.\.)?\}$')
USERNAME = re.compile(r'[A-Za-z_][A-Za-z0-9_.-]{0,31}\Z')
PACKAGE = re.compile(r'[a-z0-9][a-z0-9+.-]*(?::[a-z0-9][a-z0-9-]*)?\Z')
HOST = re.compile(r'(?:[A-Za-z_][A-Za-z0-9_.-]*@)?(?:[A-Za-z0-9][A-Za-z0-9_.-]*|\[[0-9A-Fa-f:]+\]|[0-9A-Fa-f:]+)\Z')
COMMAND_NAME = re.compile(r'[A-Za-z0-9][A-Za-z0-9_.+-]{0,254}\Z')
OPTION_NAME = re.compile(r'(?:--?[A-Za-z0-9][A-Za-z0-9_-]*|-[?@#])\Z')
UNSUPPORTED = frozenset(';|&<>`$(){}\\#!*?~')


def tokenize(phrase):
    """Parse literal arguments; shell programs, expansions and lines are refused."""
    if not isinstance(phrase, str) or len(phrase.encode('utf-8')) > MAX_INPUT_BYTES:
        raise ValueError('phrase is too long')
    # One line terminator from printf/input is accepted; embedded lines are not.
    if phrase.endswith('\n'):
        phrase = phrase[:-1]
        if phrase.endswith('\r'):
            phrase = phrase[:-1]
    if any(unicodedata.category(c) == 'Cc' and c != '\t' or c in '\u2028\u2029'
           or unicodedata.category(c) == 'Cf'
           or c in UNSUPPORTED for c in phrase):
        raise ValueError('phrase contains unsupported shell syntax')
    # A possessive is natural language, not an unterminated shell quote. Only
    # this complete, known password phrase receives the possessive treatment.
    phrase = re.sub(r"^\s*(change|reset)\s+([A-Za-z_][A-Za-z0-9_.-]{0,31})['’]s\s+password\s*$",
                    r'\1 \2 password', phrase, flags=re.IGNORECASE)
    try:
        tokens = shlex.split(phrase, comments=False, posix=True)
    except ValueError as exc:
        raise ValueError('phrase contains unmatched quotes') from exc
    if len(tokens) > MAX_TOKENS or any(len(t) > MAX_TOKEN_LENGTH for t in tokens):
        raise ValueError('phrase has too many or oversized arguments')
    return tokens


def load_catalogue(path=CATALOGUE):
    with Path(path).open('rb') as source:
        raw = source.read(131073)
    if len(raw) > 131072:
        raise ValueError('catalogue is too large')
    catalogue = json.loads(raw)
    if catalogue.get('schema_version') != 1:
        raise ValueError('unsupported catalogue version')
    intents = catalogue.get('intents')
    if not isinstance(intents, list) or len(intents) > 128:
        raise ValueError('invalid intent catalogue')
    for intent in intents:
        if (not isinstance(intent, dict) or intent.get('kind') not in
                ('suggestion', 'incomplete', 'ambiguous') or
                not re.fullmatch('[a-z][a-z0-9-]*', intent.get('id', '')) or
                not isinstance(intent.get('message'), str) or
                any(c in intent['message'] for c in '\r\n') or
                not isinstance(intent.get('privileged', False), bool)):
            raise ValueError('invalid intent definition')
        patterns = intent.get('patterns')
        if not isinstance(patterns, list) or not patterns or len(patterns) > 64:
            raise ValueError('invalid intent patterns')
        arguments = intent.get('arguments', {})
        if (not isinstance(arguments, dict) or
                any(v not in ('username', 'package', 'host', 'query') for v in arguments.values())):
            raise ValueError('invalid argument types')
        for pattern in patterns:
            if not isinstance(pattern, list) or not pattern or len(pattern) > MAX_TOKENS:
                raise ValueError('invalid intent pattern')
            seen = set()
            for i, token in enumerate(pattern):
                if not isinstance(token, str) or not token or len(token) > MAX_TOKEN_LENGTH:
                    raise ValueError('invalid intent token')
                slot = SLOT.fullmatch(token)
                if slot:
                    name, many = slot.groups()
                    if name not in arguments or name in seen or many and i != len(pattern) - 1:
                        raise ValueError('invalid intent argument slot')
                    seen.add(name)
        command = intent.get('command', [])
        if (not isinstance(command, list) or
                intent['kind'] == 'suggestion' and not command or
                intent['kind'] != 'suggestion' and command):
            raise ValueError('invalid intent command')
        for token in command:
            if not isinstance(token, str) or not token or any(c in token for c in '\r\n'):
                raise ValueError('invalid command token')
            slot = SLOT.fullmatch(token)
            if slot and slot[1] not in arguments:
                raise ValueError('undefined command argument')
    actions = catalogue.get('command_actions', [])
    if not isinstance(actions, list) or len(actions) > 16:
        raise ValueError('invalid command action catalogue')
    for group in actions:
        if (not isinstance(group, dict) or not COMMAND_NAME.fullmatch(group.get('command', ''))
                or not isinstance(group.get('actions'), dict) or len(group['actions']) > 64
                or any(not COMMAND_NAME.fullmatch(k) or not isinstance(v, bool)
                       for k, v in group['actions'].items())):
            raise ValueError('invalid command actions')
    return catalogue


def one_edit(left, right):
    """One insertion, deletion, substitution or adjacent transposition."""
    if left == right:
        return 0
    if abs(len(left) - len(right)) > 1:
        return 2
    if len(left) == len(right):
        different = [i for i, (a, b) in enumerate(zip(left, right)) if a != b]
        if len(different) == 1:
            return 1
        if (len(different) == 2 and different[1] == different[0] + 1 and
                left[different[0]] == right[different[1]] and
                left[different[1]] == right[different[0]]):
            return 1
        return 2
    shorter, longer = (left, right) if len(left) < len(right) else (right, left)
    for i, (a, b) in enumerate(zip(shorter, longer)):
        if a != b:
            return 1 if shorter[i:] == longer[i + 1:] else 2
    return 1


def argument_valid(kind, values):
    if not values or any(not v or v.startswith('-') for v in values):
        return False
    expression = {'username': USERNAME, 'package': PACKAGE, 'host': HOST}.get(kind)
    return all(expression.fullmatch(v) for v in values) if expression else True


def match_pattern(pattern, tokens, arguments, fuzzy):
    captured = {}
    offset = score = 0
    for piece in pattern:
        slot = SLOT.fullmatch(piece)
        if slot:
            name, many = slot.groups()
            values = tokens[offset:] if many else tokens[offset:offset + 1]
            if not argument_valid(arguments[name], values):
                return None
            captured[name] = values
            offset += len(values)
        else:
            if offset == len(tokens):
                return None
            actual = tokens[offset].casefold()
            expected = piece.casefold()
            cost = one_edit(actual, expected) if fuzzy and len(expected) >= 3 else int(actual != expected) * 2
            score += cost
            if score > int(fuzzy):
                return None
            offset += 1
    return (score, captured) if offset == len(tokens) else None


def proposal(intent, captured, root):
    result = {'kind': intent['kind'], 'command': None,
              'message': intent['message'].format_map({k: ' '.join(v) for k, v in captured.items()}),
              'intent': intent['id']}
    if intent['kind'] == 'suggestion':
        argv = []
        for token in intent['command']:
            slot = SLOT.fullmatch(token)
            argv.extend(captured[slot[1]] if slot else [token])
        if intent.get('privileged') and not root:
            argv.insert(0, 'sudo')
        result['command'] = shlex.join(argv)
    return result


def choose_intent(catalogue, tokens, root, fuzzy=False):
    matches = []
    for intent in catalogue['intents']:
        for pattern in intent['patterns']:
            matched = match_pattern(pattern, tokens, intent.get('arguments', {}), fuzzy)
            if matched is not None:
                score, captured = matched
                matches.append((score, proposal(intent, captured, root)))
    if not matches:
        return None
    best = min(score for score, _ in matches)
    outcomes = {json.dumps(result, sort_keys=True) for score, result in matches if score == best}
    if len(outcomes) == 1:
        return json.loads(outcomes.pop())
    return {'kind': 'ambiguous', 'command': None, 'intent': 'ambiguous-phrase',
            'message': 'This phrase has more than one meaning. Use a more specific command or target.'}


def discover_commands(path=None):
    """Inspect executable regular files only. Never execute PATH entries."""
    directories = (os.environ.get('PATH', '') if path is None else path).split(os.pathsep)
    if len(directories) > MAX_PATH_DIRECTORIES:
        return set(), False
    commands = set()
    for directory in dict.fromkeys(directories):
        # Ignore current-directory and relative entries; do not invent a new
        # trusted executable from a working directory.
        if not os.path.isabs(directory):
            continue
        try:
            with os.scandir(directory) as entries:
                for count, entry in enumerate(entries, 1):
                    if count > MAX_DIRECTORY_ENTRIES:
                        return commands, False
                    if not COMMAND_NAME.fullmatch(entry.name):
                        continue
                    try:
                        mode = entry.stat(follow_symlinks=True).st_mode
                        if stat.S_ISREG(mode) and os.access(entry.path, os.X_OK):
                            commands.add(entry.name)
                    except OSError:
                        continue
                    if len(commands) > MAX_COMMANDS:
                        return commands, False
        except OSError:
            continue
    return commands, True


def resolve_command(name, path=None):
    """Resolve actual PATH precedence, including relative entries, without exec."""
    if not COMMAND_NAME.fullmatch(name):
        return None
    directories = (os.environ.get('PATH', '') if path is None else path).split(os.pathsep)
    if len(directories) > MAX_PATH_DIRECTORIES:
        return None
    for directory in directories:
        candidate = Path(directory or '.') / name
        try:
            if candidate.is_file() and os.access(candidate, os.X_OK):
                return str(candidate.resolve(strict=True))
        except (OSError, RuntimeError):
            continue
    return None


def matching_metadata(name, index, path=None):
    """A packaged manual may not describe a different executable shadowing it."""
    record = index.get(name, {})
    expected = record.get('executable')
    if not expected or resolve_command(name, path) != expected:
        return {}
    if not record.get('executable_signature') or file_signature(expected) != record['executable_signature']:
        return {}
    if record.get('manual'):
        try:
            if not record.get('manual_file') or not Path(record['manual_file']).is_file():
                return {}
            if not record.get('manual_signature') or file_signature(record['manual_file']) != record['manual_signature']:
                return {}
            dependencies = record.get('manual_dependencies')
            if not dependencies or any(file_signature(item[0]) != item[1] for item in dependencies):
                return {}
        except (OSError, RuntimeError):
            return {}
    return record


def file_signature(path):
    """Identity and change timestamps, not file contents or user command text."""
    try:
        value = Path(path).stat()
        if not stat.S_ISREG(value.st_mode):
            return None
        return [value.st_dev, value.st_ino, value.st_size, value.st_mtime_ns, value.st_ctime_ns]
    except (OSError, ValueError, RuntimeError):
        return None


def live_metadata(name, index, path=None, root=None):
    """Read a newly installed manual on demand; a stale cache never supplies flags."""
    record = matching_metadata(name, index, path)
    if record.get('manual'):
        return record
    executable = resolve_command(name, path)
    if not executable:
        return {}
    # A system manual must not be attached to a user executable of the same
    # name. The index builder can associate fixture/custom documentation
    # explicitly; live lookup is confined to standard packaged executable roots.
    prefix = Path(executable).parent
    if root is None:
        if any(Path(executable).is_relative_to(base) for base in ('/usr/bin', '/usr/sbin', '/bin', '/sbin')):
            root = MAN_ROOT
        elif prefix.name in ('bin', 'sbin'):
            root = prefix.parent / 'share/man'
        else:
            return {'executable': executable, 'description': '', 'options': [], 'actions': []}
    root = Path(root)
    record = {'executable': executable, 'executable_signature': file_signature(executable),
              'description': '', 'options': [], 'actions': []}
    for section in ('1', '8', '6'):
        for suffix in ('.gz', ''):
            manual = root / ('man' + section) / (name + '.' + section + suffix)
            text = read_manual(manual, root)
            if text:
                record.update(manual_metadata(text, name))
                record.update({'manual': name + '(' + section + ')', 'manual_file': str(manual.absolute()),
                               'manual_root': str(root.absolute()), 'manual_signature': file_signature(manual),
                               'manual_dependencies': manual_dependencies(manual, root)})
                return record
    return record


def action_typo(catalogue, tokens, root):
    explicit_sudo = tokens[0] == 'sudo'
    argv = tokens[1:] if explicit_sudo else tokens
    if len(argv) < 2:
        return None
    for group in catalogue.get('command_actions', []):
        if argv[0] != group['command'] or argv[1] in group['actions'] or len(argv[1]) < 4:
            continue
        candidates = sorted(a for a in group['actions'] if one_edit(argv[1], a) == 1)
        if not candidates:
            return None
        if len(candidates) > 1:
            return {'kind': 'ambiguous', 'command': None, 'intent': 'ambiguous-action-typo',
                    'message': 'More than one package action matches. Type the intended action explicitly.'}
        action = candidates[0]
        corrected = [argv[0], action, *argv[2:]]
        if explicit_sudo or not root and group['actions'][action]:
            corrected.insert(0, 'sudo')
        return {'kind': 'suggestion', 'command': shlex.join(corrected), 'intent': 'package-action-typo',
                'message': 'Correct the package action only; keep every supplied argument unchanged.'}
    return None


def plain_manual(text):
    """Read roff as data. No formatter, command, include or macro is executed."""
    text = re.sub(r'\\f(?:\[[^]\n]*\]|\([^\n]{2}|.)', '', text)
    text = re.sub(r'\\s(?:[+-]?\d+|\[[^]\n]*\])', '', text)
    text = text.replace('\\-', '-').replace('\\(em', '-').replace('\\(en', '-')
    text = text.replace('\\&', '').replace('\\e', '\\').replace('\\~', ' ')
    text = re.sub(r'^\.[A-Za-z][A-Za-z0-9]*\s*', '', text)
    text = re.sub(r'\\\[[^]\n]*\]|\\\([^\n]{2}', ' ', text)
    return ' '.join(''.join(c for c in text if unicodedata.category(c)
                           not in ('Cc', 'Cf')).strip('"').split())


def read_manual(path, root=MAN_ROOT, depth=0):
    """Bounded packaged manuals, including data-only .so links within man root."""
    try:
        path, root = Path(path).resolve(), Path(root).resolve()
        if depth > 4 or not path.is_relative_to(root) or not path.is_file():
            return ''
        opener = gzip.open if path.suffix == '.gz' else open
        with opener(path, 'rb') as source:
            raw = source.read(MAX_MAN_BYTES + 1)
        if len(raw) > MAX_MAN_BYTES:
            return ''
        text = raw.decode('utf-8', errors='replace')
        links = [line.split(None, 1)[1].strip() for line in text.splitlines()
                 if line.startswith('.so ')]
        if links:
            # Only a pure man-page include is followed. Other roff remains data.
            body = [line for line in text.splitlines() if line.strip() and not line.startswith('.\\"')]
            if len(body) != 1 or len(links) != 1:
                return text
            target = root / links[0]
            if not target.exists() and not str(target).endswith('.gz'):
                target = Path(str(target) + '.gz')
            return read_manual(target, root, depth + 1)
        return text
    except (OSError, EOFError, ValueError, RuntimeError):
        return ''


def manual_dependencies(path, root=MAN_ROOT, depth=0):
    """Track .so data includes too, so target changes invalidate cached flags."""
    try:
        path, root = Path(path).resolve(), Path(root).resolve()
        if depth > 4 or not path.is_relative_to(root) or not path.is_file():
            return []
        dependencies = [[str(path), file_signature(path)]]
        opener = gzip.open if path.suffix == '.gz' else open
        with opener(path, 'rb') as source:
            raw = source.read(MAX_MAN_BYTES + 1)
        if len(raw) > MAX_MAN_BYTES:
            return []
        body = [line for line in raw.decode('utf-8', 'replace').splitlines()
                if line.strip() and not line.startswith('.\\"')]
        if len(body) == 1 and body[0].startswith('.so '):
            target = root / body[0].split(None, 1)[1].strip()
            if not target.exists() and not str(target).endswith('.gz'):
                target = Path(str(target) + '.gz')
            included = manual_dependencies(target, root, depth + 1)
            return dependencies + included if included else []
        return dependencies
    except (OSError, EOFError, ValueError, RuntimeError):
        return []


def manual_metadata(text, command=None):
    """Extract declaration syntax as data; prose and examples are not a grammar."""
    description, name_lines, options, actions = '', [], set(), set()
    explicit_actions = set()
    major = section = ''
    awaiting_entry = option_entry = False
    lines = text.splitlines()
    formatting = ('.HP', '.sp', '.br', '.RS', '.RE', '.nf', '.fi', '.ad', '.na',
                  '.PD', '.Vb', '.Ve', '.Bl', '.El', '.Xc', '.Pp')

    def flags(value):
        # Read only an already established declaration or synopsis. This regex
        # is not applied to arbitrary prose, file names or roff layout options.
        return {flag for flag in re.findall(r'(?<![A-Za-z0-9_-])(?:--?[A-Za-z0-9][A-Za-z0-9_-]*|-[?@#])', value)
                if len(flag) <= MAX_TOKEN_LENGTH and OPTION_NAME.fullmatch(flag)}

    def mdoc_flags(raw):
        # Fl can be nested in .Op/.It and repeated without another leading dot.
        # Preserve a documented bundle such as -dErx rather than inventing its
        # component options or an argument arity.
        return {'-' + value for value in re.findall(r'(?:^\.|\s)Fl\s+(-?[A-Za-z0-9][A-Za-z0-9_-]*|[?@#])', raw)
                if len(value) < MAX_TOKEN_LENGTH}

    for position, raw in enumerate(lines):
        if raw.startswith(('.SH ', '.SS ', '.Sh ', '.Ss ')):
            section = plain_manual(raw).upper()
            if raw.startswith(('.SH ', '.Sh ')):
                major = section
            awaiting_entry = 'COMMAND' in section and not any(
                word in section for word in ('PARSING', 'EXECUTION', 'SYNTAX'))
            option_entry = False
            continue
        line = plain_manual(raw)
        if raw.strip() in ('.PP', '.TP', '.TQ') or raw.startswith('.IP '):
            option_entry = 'OPTION' in major
            awaiting_entry = 'COMMAND' in section and not any(
                word in section for word in ('PARSING', 'EXECUTION', 'SYNTAX'))
        if major == 'NAME' and line and not raw.startswith('.\\"'):
            if raw.startswith('.Nd '):
                description = line
            elif not raw.startswith('.') or raw.startswith(('.B ', '.BR ', '.Nm ')):
                name_lines.append(line)
        if not line or raw.startswith('.\\"'):
            continue
        macro = raw.split(None, 1)[0] if raw.startswith('.') else ''
        is_layout = macro in formatting or macro.startswith('.\\')
        in_synopsis = major == 'SYNOPSIS'
        if in_synopsis and not is_layout:
            if 'Fl ' in raw:
                options.update(mdoc_flags(raw))
            elif not raw.startswith('.') or macro in ('.B', '.BR', '.BI', '.RB', '.RI', '.IR', '.IB'):
                options.update(flags(line))
        # mdoc option declarations have explicit Fl tokens. Formatting such as
        # .Bl -tag -width and prose references such as ssh-add -L are excluded.
        if raw.startswith('.It ') and major in ('SYNOPSIS', 'OPTIONS', 'DESCRIPTION'):
            options.update(mdoc_flags(raw))
        if option_entry and not is_layout and raw.strip() not in ('.PP', '.TP', '.TQ'):
            # A tag beginning with a flag is a declaration. A paragraph that
            # merely mentions a flag somewhere in its prose is not.
            payload = line.lstrip('"')
            if payload.startswith('-'):
                options.update(flags(payload))
            option_entry = False
        if raw.startswith(('.It ', '.IP ')) and 'COMMAND' in section:
            awaiting_entry = True
        mdoc_entry = raw.startswith(('.It Ic ', '.It Xo Ic ', '.It Cm ', '.It Xo Cm '))
        if mdoc_entry and 'COMMAND' not in section:
            # Some mdoc manuals put command declarations in topical chapters.
            # Accept a bounded syntax block with its own Fl options or explicit
            # command alias, but never style/option value lists. A declaration
            # without enough evidence remains available only in the full man.
            block = []
            for following in lines[position + 1:position + 33]:
                if following.startswith(('.It ', '.Sh ', '.Ss ', '.SH ', '.SS ')):
                    break
                block.append(following)
                if following == '.Xc':
                    continue
                if not following.startswith('.'):
                    break
            syntax = '\n'.join(block)
            excluded = any(word in section for word in ('STYLE', 'FORMAT', 'ENVIRONMENT', 'TERMINFO'))
            awaiting_entry = not excluded and bool(re.search(r'(?:^|\n)\.Op Fl\s|alias:\s+Ic\s', syntax))
        if not awaiting_entry or is_layout or raw.strip() in ('.PP', '.TP', '.TQ'):
            continue
        # Only bold declarations or explicit mdoc command tokens are eligible.
        if raw.startswith('.') and macro not in ('.B', '.BR', '.BI', '.IP', '.It', '.Ic'):
            continue
        declared = [plain_manual(value) for value in re.findall(r'\\fB(.+?)\\f[RP]', raw)]
        if macro in ('.B', '.BR', '.BI'):
            declared.append(line.split()[0].strip('"'))
        mdoc = re.match(r'^\.It (?:Xo )?(?:Cm|Ic)\s+([^\s,]+)', raw)
        if mdoc:
            declared.append(mdoc[1])
        if macro == '.Ic':
            declared.append(line)
        for entry in declared[:1]:
            pieces = entry.strip('"').split()
            if command and len(pieces) > 1 and pieces[0] == command:
                pieces = pieces[1:]
                if COMMAND_NAME.fullmatch(pieces[0]) and not pieces[0].startswith('-'):
                    explicit_actions.add(pieces[0])
            if pieces:
                candidate = pieces[0]
                if COMMAND_NAME.fullmatch(candidate) and not candidate.startswith('-') and candidate != command:
                    actions.add(candidate)
        if not raw.startswith('.') or declared:
            awaiting_entry = False
    if not description:
        name = ' '.join(name_lines)
        description = name.split(' - ', 1)[1] if ' - ' in name else ''
    return {'description': description[:240], 'options': sorted(options)[:512],
            'actions': sorted(explicit_actions or actions)[:256]}


def build_command_index(commands, root=MAN_ROOT, path=None):
    root = Path(root)
    manuals = {}
    for section in ('1', '8', '6'):
        directory = root / ('man' + section)
        try:
            with os.scandir(directory) as iterator:
                paths = []
                for entry in iterator:
                    paths.append(Path(entry.path))
                    if len(paths) > MAX_DIRECTORY_ENTRIES:
                        break
        except OSError:
            continue
        if len(paths) > MAX_DIRECTORY_ENTRIES:
            continue
        for manual in sorted(paths):
            match = re.fullmatch(r'(.+)\.(' + section + r'[A-Za-z0-9]*)(?:\.gz)?', manual.name)
            if match and match[1] in commands:
                manuals.setdefault(match[1], []).append((manual, match[2]))
    entries = {}
    for name in sorted(commands):
        metadata = {'description': '', 'options': [], 'actions': []}
        for manual, section in manuals.get(name, []):
            text = read_manual(manual, root)
            if text:
                metadata = manual_metadata(text, name)
                metadata['manual'] = name + '(' + section + ')'
                metadata['manual_file'] = str(manual.absolute())
                metadata['manual_root'] = str(root.absolute())
                metadata['manual_signature'] = file_signature(manual)
                metadata['manual_dependencies'] = manual_dependencies(manual, root)
                metadata['actions'] = sorted({action[len(name) + 1:] if action.startswith(name + '-') else action
                                              for action in metadata['actions']})
                break
        metadata['executable'] = resolve_command(name, path)
        metadata['executable_signature'] = file_signature(metadata['executable']) if metadata['executable'] else None
        entries[name] = metadata
    return {'schema_version': 1, 'commands': entries}


def load_command_index(path=COMMAND_INDEX):
    try:
        # A malformed FIFO or symlink must not block an interactive shell.
        descriptor = os.open(path, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
        with os.fdopen(descriptor, 'rb') as source:
            info = os.fstat(source.fileno())
            if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
                return {}
            raw = source.read(MAX_INDEX_BYTES + 1)
        if len(raw) > MAX_INDEX_BYTES:
            return {}
        value = json.loads(raw)
        if not isinstance(value, dict) or value.get('schema_version') != 1 or not isinstance(value.get('commands'), dict):
            return {}
        entries = value['commands']
        if len(entries) > MAX_COMMANDS:
            return {}
        for name, record in entries.items():
            if not COMMAND_NAME.fullmatch(name) or not isinstance(record, dict):
                return {}
            description = record.get('description', '')
            if (not isinstance(description, str) or len(description) > 240 or
                    any(unicodedata.category(c) in ('Cc', 'Cf')
                        for c in description)):
                return {}
            executable = record.get('executable')
            if executable is not None and (not isinstance(executable, str) or
                    len(executable) > MAX_INPUT_BYTES or not os.path.isabs(executable) or
                    any(unicodedata.category(c) in ('Cc', 'Cf') for c in executable)):
                return {}
            manual = record.get('manual')
            if manual is not None and (not isinstance(manual, str) or
                    not re.fullmatch(re.escape(name) + r'\([186][A-Za-z0-9]*\)', manual)):
                return {}
            manual_file = record.get('manual_file')
            if manual_file is not None and (not isinstance(manual_file, str) or
                    len(manual_file) > MAX_INPUT_BYTES or not os.path.isabs(manual_file) or
                    any(unicodedata.category(c) in ('Cc', 'Cf') for c in manual_file)):
                return {}
            manual_root = record.get('manual_root')
            if manual_root is not None and (not isinstance(manual_root, str) or not os.path.isabs(manual_root) or
                    len(manual_root) > MAX_INPUT_BYTES or any(unicodedata.category(c) in ('Cc', 'Cf') for c in manual_root)):
                return {}
            for key, maximum, pattern in (('options', 512, OPTION_NAME),
                                          ('actions', 256, COMMAND_NAME)):
                items = record.get(key, [])
                if (not isinstance(items, list) or len(items) > maximum or
                        any(not isinstance(item, str) or len(item) > MAX_TOKEN_LENGTH or
                            not re.fullmatch(pattern, item) for item in items)):
                    return {}
            for key in ('executable_signature', 'manual_signature'):
                signature = record.get(key)
                if signature is not None and (not isinstance(signature, list) or len(signature) != 5 or
                        any(type(item) is not int or item < 0 for item in signature)):
                    return {}
            dependencies = record.get('manual_dependencies', [])
            if not isinstance(dependencies, list) or len(dependencies) > 5:
                return {}
            for item in dependencies:
                if (not isinstance(item, list) or len(item) != 2 or not isinstance(item[0], str) or
                        not os.path.isabs(item[0]) or len(item[0]) > MAX_INPUT_BYTES or
                        any(unicodedata.category(c) in ('Cc', 'Cf') for c in item[0]) or
                        not isinstance(item[1], list) or len(item[1]) != 5 or
                        any(type(number) is not int or number < 0 for number in item[1])):
                    return {}
        return entries
    except (OSError, ValueError, TypeError, RecursionError):
        return {}


def refresh_command_index():
    if os.geteuid() != 0:
        raise ValueError('refreshing the system command index requires root')
    system_path = '/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
    commands, complete = discover_commands(system_path)
    if not complete:
        raise ValueError('the executable inventory exceeds its bounds')
    index = build_command_index(commands, path=system_path)
    payload = json.dumps(index, ensure_ascii=True, sort_keys=True, separators=(',', ':')) + '\n'
    if len(payload.encode('utf-8')) > MAX_INDEX_BYTES:
        raise ValueError('the documented command index exceeds its bounds')
    COMMAND_INDEX.parent.mkdir(parents=True, exist_ok=True, mode=0o755)
    parent = COMMAND_INDEX.parent.lstat()
    if not stat.S_ISDIR(parent.st_mode) or parent.st_uid != 0 or parent.st_mode & 0o022:
        raise ValueError('the system command cache is not root controlled')
    descriptor, temporary = tempfile.mkstemp(prefix='.command-index-', dir=COMMAND_INDEX.parent)
    try:
        with os.fdopen(descriptor, 'w') as destination:
            destination.write(payload)
            destination.flush()
            os.fsync(destination.fileno())
            os.fchmod(destination.fileno(), 0o644)
        os.replace(temporary, COMMAND_INDEX)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return index


def documented_typo(tokens, commands, index, path=None):
    offset = 1 if tokens[0] == 'sudo' else 0
    if len(tokens) <= offset + 1 or tokens[offset] not in commands:
        return None
    # shlex deliberately does not implement shell glob expansion. Requoting a
    # bracket pattern as a literal while correcting another word changes argv.
    if any('[' in token or ']' in token for token in tokens[offset + 1:]):
        return None
    record = live_metadata(tokens[offset], index, path)
    argv = tokens.copy()
    # End-of-options and literal values stay under the command's own parser.
    end = argv.index('--', offset + 1) if '--' in argv[offset + 1:] else len(argv)
    unknown = [(i, arg.partition('=')[0]) for i, arg in enumerate(argv[offset + 1:end], offset + 1)
               if arg.startswith('--') and len(arg.partition('=')[0]) >= 5 and
               arg.partition('=')[0] not in record.get('options', [])]
    # Without a full command-specific argument grammar, a later --word might
    # be the value of --regexp/--output/etc. Only the first argument is eligible.
    if len(unknown) == 1 and unknown[0][0] == offset + 1:
        position, actual = unknown[0]
        candidates = [option for option in record.get('options', [])
                      if option.startswith(actual) or one_edit(actual, option) == 1]
        if len(candidates) == 1:
            _, separator, value = argv[position].partition('=')
            argv[position] = candidates[0] + (separator + value if separator else '')
            return {'kind': 'suggestion', 'command': shlex.join(argv), 'intent': 'documented-option',
                    'message': 'Use a flag documented by this installed command; preserve supplied values.'}
    if (len(argv) > offset + 1 and not argv[offset + 1].startswith('-') and
            len(argv[offset + 1]) >= 4 and argv[offset + 1] not in record.get('actions', [])):
        actual = argv[offset + 1]
        candidates = [action for action in record.get('actions', []) if one_edit(actual, action) == 1]
        if len(candidates) == 1:
            argv[offset + 1] = candidates[0]
            return {'kind': 'suggestion', 'command': shlex.join(argv), 'intent': 'documented-subcommand',
                    'message': 'Use a subcommand documented by this installed command; preserve all targets.'}
    return None


def command_help(phrase, *, path=None, index=None):
    tokens = tokenize(phrase)
    commands, complete = discover_commands(path)
    index = load_command_index() if index is None else index
    if not complete:
        return 'Command discovery exceeded its bounds; native shell completion remains available.'
    offset = 1 if tokens and tokens[0] == 'sudo' else 0
    if len(tokens) > offset and tokens[offset] in commands:
        name = tokens[offset]
        record = live_metadata(name, index, path)
        lines = [name + (' - ' + record['description'] if record.get('description') else ' - installed command')]
        for label, key in (('Subcommands', 'actions'), ('Options', 'options')):
            values = record.get(key, [])
            if values:
                lines.append(label + ': ' + ' '.join(values[:18]) + (' ...' if len(values) > 18 else ''))
        lines.append('Tab: native completion. ' +
                     ('Full local manual: man ' + name if record.get('manual') else
                      'No packaged manual metadata is available for this command.'))
        return '\n'.join(lines)
    words = {word.casefold() for word in tokens if len(word) >= 3 and
             word.casefold() not in {'the', 'how', 'can', 'with', 'for', 'and', 'show', 'please'}}
    ranked = []
    for name in commands:
        record = matching_metadata(name, index, path)
        corpus = set(re.findall(r'[a-z0-9]+', (name + ' ' + record.get('description', '')).casefold()))
        score = len(words & corpus)
        if score:
            ranked.append((score, name, record.get('description', '')))
    ranked.sort(key=lambda item: (-item[0], item[1]))
    if not words or not ranked:
        return 'Type a command and press F1 for local options, or use kythos-help with command-description words.'
    return 'Local command matches (review their manuals):\n' + '\n'.join(
        '  ' + name + (' - ' + description if description else '') for _, name, description in ranked[:6])


def suggest(phrase, catalogue, *, root=None, path=None, index=None):
    if sensitive_line(phrase):
        return None
    tokens = tokenize(phrase)
    if not tokens:
        return None
    root = os.geteuid() == 0 if root is None else root
    result = choose_intent(catalogue, tokens, root)
    if result is not None:
        return result
    result = action_typo(catalogue, tokens, root)
    if result is not None:
        return result
    commands, complete = discover_commands(path)
    if not complete:
        return None
    result = documented_typo(tokens, commands, load_command_index() if index is None else index, path)
    if result is not None:
        return result
    # An exact command keeps its semantics; only documented flag/action typos
    # above are eligible. File names and unknown argument values stay untouched.
    offset = 1 if tokens[0] == 'sudo' and len(tokens) > 1 and not tokens[1].startswith('-') else 0
    if tokens[offset] in commands or resolve_command(tokens[offset], path) is not None:
        return None
    result = choose_intent(catalogue, tokens, root, fuzzy=True) if offset == 0 else None
    if result is not None:
        return result
    if len(tokens[offset]) < 4 or not COMMAND_NAME.fullmatch(tokens[offset]):
        return None
    # Shell glob expansion belongs to Bash. Quoting a bracket expression here
    # could silently change its meaning. Explicit IPv6 host slots above remain
    # available because their intended literal argument is known.
    if any('[' in token or ']' in token for token in tokens[offset + 1:]):
        return None
    case_matches = sorted(c for c in commands if c.casefold() == tokens[offset].casefold())
    candidates = case_matches or sorted(c for c in commands if one_edit(tokens[offset], c) == 1)
    if not candidates:
        return None
    if len(candidates) > 1:
        return {'kind': 'ambiguous', 'command': None, 'intent': 'ambiguous-command-typo',
                'message': 'More than one executable matches this command. Type its full name.'}
    directories = (os.environ.get('PATH', '') if path is None else path).split(os.pathsep)
    absolute_path = os.pathsep.join(directory for directory in directories if os.path.isabs(directory))
    if resolve_command(candidates[0], path) != resolve_command(candidates[0], absolute_path):
        return None
    corrected = tokens.copy()
    corrected[offset] = candidates[0]
    return {'kind': 'suggestion', 'command': shlex.join(corrected),
            'message': 'Correct the executable name only; keep every supplied argument unchanged.',
            'intent': 'command-typo'}


def parse_shell_line(line):
    """Describe shell syntax as data, preserving quoted operator arguments.

    This is a bounded inspector, never a shell parser for execution. Expansions,
    grouping, compound commands and here-documents are explicitly uncertain.
    """
    if not isinstance(line, str) or len(line.encode('utf-8')) > MAX_INPUT_BYTES:
        return {'segments': [], 'warnings': ['Input exceeds the inspection limit.']}
    warnings, words, current = [], [], []
    start, quote, quoted, offset = None, None, False, 0
    operators = ('&>>', '<<<', '>>', '<<', '&&', '||', '|&', '>&', '<&', '<>', '&>', '|', '>', '<', ';', '&')

    def flush(end):
        nonlocal current, start, quoted
        if start is not None:
            words.append(('word', ''.join(current), start, end, quoted))
        current, start, quoted = [], None, False

    while offset < len(line):
        char = line[offset]
        if unicodedata.category(char) in ('Cc', 'Cf') and char != '\t':
            warnings.append('Control characters or multiple lines are outside safe inspection.')
            return {'segments': [], 'warnings': warnings}
        if quote == "'":
            if char == quote:
                quote = None
            else:
                current.append(char)
            offset += 1
            continue
        if char == '\\':
            if start is None:
                start = offset
            quoted = True
            if offset + 1 >= len(line):
                warnings.append('The final escape is incomplete.')
                break
            following = line[offset + 1]
            if quote == '"' and following not in '$`"\\\n':
                current.append('\\')
            current.append(following)
            offset += 2
            continue
        if quote == '"':
            if char == '"':
                quote = None
            else:
                current.append(char)
                if char in '$`':
                    warnings.append('Shell expansion is present; values are not evaluated.')
            offset += 1
            continue
        if char in "'\"":
            if start is None:
                start = offset
            quote, quoted = char, True
            offset += 1
            continue
        if char.isspace():
            flush(offset)
            offset += 1
            continue
        if char == '#' and start is None:
            break
        operator = next((item for item in operators if line.startswith(item, offset)), None)
        if operator:
            flush(offset)
            words.append(('operator', operator, offset, offset + len(operator), False))
            offset += len(operator)
            continue
        if start is None:
            start = offset
        current.append(char)
        if char in '$`':
            warnings.append('Shell expansion is present; values are not evaluated.')
        elif char in '(){}':
            warnings.append('Grouping or compound syntax is outside this literal inspection.')
        elif char in '*?[' or char == '~' and len(current) == 1:
            warnings.append('Path expansion is left to the shell; matched files are not guessed.')
        offset += 1
    flush(offset)
    if quote:
        warnings.append('A quote is incomplete; close it before execution.')
    segments, segment, position = [], {'argv': [], 'quoted': [], 'redirections': [], 'operator': None}, 0
    while position < len(words):
        kind, value, begin, end, quoted = words[position]
        if kind == 'operator' and value in ('|', '|&', '&&', '||', ';', '&'):
            segment['operator'] = value
            if segment['argv'] or segment['redirections']:
                segments.append(segment)
            else:
                warnings.append('A shell operator has no preceding command.')
            segment = {'argv': [], 'quoted': [], 'redirections': [], 'operator': None}
        elif kind == 'operator':
            descriptor = ''
            if (position and words[position - 1][0] == 'word' and words[position - 1][1].isdigit()
                    and words[position - 1][3] == begin and not words[position - 1][4] and segment['argv']):
                descriptor = segment['argv'].pop()
                segment['quoted'].pop()
            target = None
            if position + 1 < len(words) and words[position + 1][0] == 'word':
                position += 1
                target = words[position][1]
            else:
                warnings.append('A redirection requires a target.')
            segment['redirections'].append({'operator': descriptor + value, 'target': target})
            if value in ('<<', '<<<'):
                warnings.append('Here-document and here-string contents are not inspected.')
        else:
            segment['argv'].append(value)
            segment['quoted'].append(quoted)
        position += 1
    if segment['argv'] or segment['redirections']:
        segments.append(segment)
    elif words and words[-1][1] in ('|', '|&', '&&', '||'):
        warnings.append('The final operator requires another command.')
    if len(words) > MAX_TOKENS * 4 or len(segments) > 16:
        return {'segments': [], 'warnings': ['The shell expression exceeds inspection limits.']}
    return {'segments': segments, 'warnings': list(dict.fromkeys(warnings))}


def clean_shell_context(value):
    """Shell names and literal completion words only, never definitions/bodies."""
    result = {key: [] for key in ('builtins', 'aliases', 'functions', 'keywords')}
    result['completions'] = {}
    if not isinstance(value, dict):
        return result
    for key in ('builtins', 'aliases', 'functions', 'keywords'):
        names = value.get(key, [])
        if isinstance(names, list):
            result[key] = sorted({name for name in names[:2048]
                                  if isinstance(name, str) and COMMAND_NAME.fullmatch(name)})
    completions = value.get('completions', {})
    if isinstance(completions, dict):
        for name, record in list(completions.items())[:2048]:
            if not isinstance(name, str) or not COMMAND_NAME.fullmatch(name) or not isinstance(record, dict):
                continue
            words = record.get('words', [])
            result['completions'][name] = {
                'dynamic': record.get('dynamic') is True,
                'words': sorted({word for word in words[:512] if isinstance(word, str) and
                                 re.fullmatch(r'[A-Za-z0-9_./:+-]{1,128}', word)}) if isinstance(words, list) else []}
    return result


def context_protocol(raw):
    """Decode NUL-separated Bash builtin output without eval or temp files."""
    if len(raw) > MAX_CONTEXT_BYTES:
        raise ValueError('shell context exceeds its inspection limit')
    fields = raw.decode('utf-8', errors='strict').split('\0')
    if len(fields) < 4:
        raise ValueError('invalid shell context')
    mode, status, line = fields[:3]
    context = {key: [] for key in ('builtins', 'aliases', 'functions', 'keywords')}
    context['completions'] = {}
    for field in fields[3:]:
        kind, separator, name = field.partition(':')
        if not separator:
            continue
        if kind in context and kind != 'completions':
            context[kind].append(name)
        elif kind == 'completion':
            try:
                tokens = shlex.split(name)
            except ValueError:
                continue
            if tokens[:1] != ['complete'] or len(tokens) > 1024:
                continue
            words, dynamic, names, position = [], False, [], 1
            # complete -p emits quoted data. Do not source it or call its -F/-C
            # callbacks. -W expansions are not evaluated either.
            options_with_value = {'-A', '-G', '-W', '-F', '-C', '-X', '-P', '-S', '-o'}
            while position < len(tokens):
                token = tokens[position]
                if token in options_with_value and position + 1 < len(tokens):
                    position += 1
                    if token == '-W':
                        if not any(char in tokens[position] for char in '$`\\*?[]~'):
                            words.extend(tokens[position].split())
                    elif token in ('-F', '-C'):
                        dynamic = True
                elif not token.startswith('-'):
                    names.append(token)
                position += 1
            for command in names:
                context['completions'][command] = {'words': words, 'dynamic': dynamic}
    return mode, int(status) if status.isdigit() else None, line, clean_shell_context(context)


def sensitive_line(line):
    # Do not repeat credential-bearing argument strings in correction previews.
    return bool(re.search(r'(?i)(?:--?\S*(?:password|passwd|secret|token|credential|authorization)|(?:^|\s)-[upH](?:\s|\S)|[A-Za-z][A-Za-z0-9+.-]*://[^\s/@:]+:[^\s/@]+@)', line))


def package_identity(executable):
    """Use only the fixed root-controlled package database reader, never --version."""
    reader = Path('/usr/bin/dpkg-query')
    try:
        info = reader.stat()
        if info.st_uid != 0 or info.st_mode & 0o022 or not stat.S_ISREG(info.st_mode):
            return None
        if not any(Path(executable).is_relative_to(base) for base in ('/usr/bin', '/usr/sbin', '/bin', '/sbin')):
            return None
        environment = {'PATH': '/usr/bin:/bin', 'LC_ALL': 'C'}
        found = subprocess.run([str(reader), '--search', executable], stdin=subprocess.DEVNULL,
                               capture_output=True, timeout=0.4, env=environment, check=False)
        if found.returncode and executable.startswith('/usr/'):
            found = subprocess.run([str(reader), '--search', executable[4:]], stdin=subprocess.DEVNULL,
                                   capture_output=True, timeout=0.4, env=environment, check=False)
        if found.returncode or len(found.stdout) > 8192:
            return None
        owner = found.stdout.decode('utf-8', 'replace').split(': ', 1)[0]
        if not PACKAGE.fullmatch(owner):
            return None
        version = subprocess.run([str(reader), '--show', '--showformat=${binary:Package} ${Version}', owner],
                                 stdin=subprocess.DEVNULL, capture_output=True, timeout=0.4,
                                 env=environment, check=False)
        text = version.stdout.decode('utf-8', 'replace')
        if version.returncode == 0 and re.fullmatch(r'[A-Za-z0-9.+:~_-]+ [A-Za-z0-9.+:~_-]+', text):
            return text
    except (OSError, ValueError, subprocess.TimeoutExpired):
        pass
    return None


def flag_explanation(record, flag):
    if not record.get('manual_file'):
        return None
    text = read_manual(record['manual_file'], record.get('manual_root', MAN_ROOT))
    lines = text.splitlines()
    for position, raw in enumerate(lines):
        if flag not in plain_manual(raw).split() and not re.search(re.escape(flag) + r'(?:[ =,\"]|$)', plain_manual(raw)):
            continue
        # Require a declaration, not an arbitrary mention in a prose paragraph.
        if not raw.startswith(('.B ', '.BR ', '.BI ', '.It Fl ', '.IP ')):
            continue
        prose = []
        for following in lines[position + 1:position + 9]:
            if following.startswith(('.TP', '.IP', '.It ', '.SH ', '.SS ', '.Sh ', '.Ss ')):
                break
            if following.startswith(('.\\', '.B ', '.BR ', '.BI ')):
                continue
            value = plain_manual(following)
            if value:
                prose.append(value)
        if prose:
            return ' '.join(prose)[:360]
    return None


def subcommand_metadata(name, arguments, record):
    """Consult a separate manual only for a documented command declaration."""
    if not arguments or arguments[0] not in record.get('actions', []) or not record.get('manual_root'):
        return record
    manual_name = name + '-' + arguments[0]
    if not COMMAND_NAME.fullmatch(manual_name):
        return record
    root = Path(record['manual_root'])
    for section in ('1', '8', '6'):
        for suffix in ('.gz', ''):
            manual = root / ('man' + section) / (manual_name + '.' + section + suffix)
            text = read_manual(manual, root)
            if text:
                child = dict(record)
                child.update(manual_metadata(text, manual_name))
                child.update({'manual': manual_name + '(' + section + ')', 'manual_file': str(manual),
                              'manual_signature': file_signature(manual),
                              'manual_dependencies': manual_dependencies(manual, root)})
                return child
    return record


def command_offset(argv, quoted=None):
    offset = 0
    while (offset < len(argv) and not (quoted and quoted[offset]) and
           re.fullmatch(r'[A-Za-z_][A-Za-z0-9_]*=.*', argv[offset])):
        offset += 1
    if offset < len(argv) and argv[offset] in ('sudo', 'command', 'builtin'):
        if offset + 1 < len(argv) and not argv[offset + 1].startswith('-'):
            offset += 1
    return offset


def shell_kind(name, argv, offset, shell):
    """Respect wrappers that bypass aliases/functions or request builtins."""
    wrapper = argv[offset - 1] if offset else None
    keys = (('aliases', 'alias'), ('functions', 'function'), ('builtins', 'builtin'), ('keywords', 'keyword'))
    for key, label in keys:
        if wrapper == 'sudo' or wrapper == 'command' and key in ('aliases', 'functions', 'keywords'):
            continue
        if wrapper == 'builtin' and key != 'builtins':
            continue
        if name in shell[key]:
            return label
    return None


def assist(line, mode='explain', status=None, shell=None, path=None, index=None, catalogue=None):
    """Extensible local assistance, deliberately independent of command execution."""
    result = {'title': 'KythOS local command assistance', 'lines': [], 'candidates': [], 'proposal': None}
    lines = result['lines']
    shell = clean_shell_context(shell)
    parsed = parse_shell_line(line)
    lines.extend(parsed['warnings'])
    if mode not in ('explain', 'complete', 'intent', 'diagnose'):
        lines.append('Unknown assistance mode. Use explain, complete, intent, or diagnose.')
        return result
    index = load_command_index() if index is None else index
    commands, complete = discover_commands(path)
    shell_names = set().union(*(set(shell[key]) for key in ('builtins', 'aliases', 'functions', 'keywords')))
    if not complete:
        lines.append('Executable discovery was bounded; use native shell completion for remaining entries.')
    if mode == 'intent':
        if parsed['warnings'] or sensitive_line(line):
            lines.append('This request needs manual inspection; no command is proposed.')
            return result
        if (len(parsed['segments']) != 1 or parsed['segments'][0]['redirections'] or
                parsed['segments'][0]['operator']):
            lines.append('This shell expression needs explicit inspection. Use --explain for pipelines, conditionals and redirections; no command is proposed.')
            return result
        if parsed['segments']:
            argv = parsed['segments'][0]['argv']
            offset = command_offset(argv, parsed['segments'][0]['quoted'])
            if len(argv) > offset and shell_kind(argv[offset], argv, offset, shell):
                lines.append('This name resolves to a shell builtin, keyword, alias or function. Its native behavior takes precedence; inspect it deliberately with help or type and use native Tab.')
                return result
        if catalogue is None:
            try:
                catalogue = load_catalogue()
            except (OSError, ValueError):
                catalogue = {'intents': [], 'command_actions': []}
        try:
            proposal = suggest(line, catalogue, path=path, index=index)
        except ValueError:
            proposal = None
        if proposal:
            result['proposal'] = proposal
            lines.append(proposal['message'])
        else:
            lines.extend(command_help(line, path=path, index=index).splitlines())
            lines.append('Description matches are leads, not an inferred argument grammar. Review local documentation.')
        return result
    segments = parsed['segments']
    if mode == 'complete':
        if parsed['warnings'] or not segments:
            lines.append('Native Tab remains available. Incomplete or expanding syntax is not rewritten.')
            return result
        argv = segments[-1]['argv']
        offset = command_offset(argv, segments[-1]['quoted'])
        trailing_space = bool(line and line[-1].isspace())
        if len(argv) <= offset + 1 and not trailing_space:
            prefix = argv[offset] if len(argv) > offset else ''
            result['candidates'] = sorted(name for name in commands | shell_names if name.startswith(prefix))[:64]
        elif len(argv) > offset:
            name = argv[offset]
            prefix = '' if trailing_space else argv[-1]
            metadata = {} if shell_kind(name, argv, offset, shell) else live_metadata(name, index, path)
            metadata = subcommand_metadata(name, argv[offset + 1:-1] if not trailing_space else argv[offset + 1:], metadata)
            completion = shell['completions'].get(name, {})
            words = set(completion.get('words', []))
            if prefix.startswith('-'):
                words.update(metadata.get('options', []))
            elif len(argv) <= offset + 2:
                words.update(metadata.get('actions', []))
            result['candidates'] = sorted(value for value in words if value.startswith(prefix))[:64]
            if completion.get('dynamic'):
                lines.append('A dynamic shell completion is registered. Native Tab invokes it using normal shell rules.')
        lines.append('Candidates are local names or documented declarations; none are executed or inserted.')
        if not result['candidates']:
            lines.append('No confident metadata completion. Native Tab can still complete files and command-specific context.')
        return result
    if mode == 'diagnose':
        details = {
            0: 'Exit status 0 reports success; inspect the command output if its result was unexpected.',
            1: 'Exit status 1 is command-specific. It may indicate failure or a normal no-match result; consult this command’s manual.',
            2: 'Exit status 2 often indicates syntax or usage failure; confirm the documented options and required arguments.',
            126: 'Exit status 126 means the shell found a command but could not execute it. Check execute permissions, directory traversal permissions, mount noexec, interpreter and architecture.',
            127: 'Exit status 127 usually means command not found. Check spelling, PATH, package installation, and any missing script interpreter.',
            130: 'Exit status 130 commonly means interruption by Ctrl-C (SIGINT).',
            137: 'Exit status 137 commonly means SIGKILL. Inspect memory pressure and service or kernel logs for an OOM kill.',
            139: 'Exit status 139 commonly means SIGSEGV. Check the exact binary version and collect a permitted crash report.'}
        lines.append(details.get(status, 'A nonzero status alone cannot identify the cause. Consult command output and the local manual.'))
        if status is None:
            lines.append('Supply --status N from the failed command; history and prior output are not collected.')
    if len(segments) > 1:
        lines.append('Pipeline/conditional: each segment has its own arguments. A pipeline normally reports its final status; Bash pipefail and PIPESTATUS expose earlier failures.')
    for segment in segments:
        argv = segment['argv']
        offset = command_offset(argv, segment['quoted'])
        if offset >= len(argv):
            lines.append('This segment contains assignments or redirections without an inspectable command.')
            continue
        name = argv[offset]
        if not COMMAND_NAME.fullmatch(name):
            lines.append('An explicit path or compound command needs its own documentation; no command name is guessed.')
            continue
        kind = shell_kind(name, argv, offset, shell)
        if kind:
            lines.append(name + ' is a shell ' + kind + '. Definitions are not read or executed; inspect deliberately with type ' + name + '.')
            if name in shell['builtins']:
                lines.append('Bash documents this builtin with: help ' + name)
            continue
        executable = resolve_command(name, path)
        if not executable:
            lines.append(name + ': not found in the current PATH. Check spelling and installation; aliases/functions are visible when called through interactive Bash.')
            continue
        record = live_metadata(name, index, path)
        record = subcommand_metadata(name, argv[offset + 1:], record)
        lines.append(name + (' - ' + record['description'] if record.get('description') else ' - installed command'))
        version = package_identity(executable)
        lines.append('Installed package/version: ' + version if version else 'Installed version is unknown from local package metadata; the executable is never probed.')
        if not record.get('manual'):
            lines.append('No packaged manual metadata is available. Flags and subcommands are uncertain; no syntax is invented.')
        else:
            lines.append('Local documentation: man ' + record['manual'].split('(', 1)[0] + '. Metadata matches the resolved executable and current manual.')
        supplied_flags = [arg.partition('=')[0] for arg in argv[offset + 1:] if arg.startswith('-') and arg != '--']
        for flag in list(dict.fromkeys(supplied_flags))[:12]:
            if not OPTION_NAME.fullmatch(flag):
                continue
            if re.search(r'(?i)password|passwd|secret|token|credential|authorization', flag):
                lines.append('A credential-related option is present; its spelling and values are not repeated. Consult the local manual.')
                continue
            if flag in record.get('options', []):
                explanation = flag_explanation(record, flag)
                lines.append(flag + ': ' + (explanation or 'declared in the local manual; consult it for values and command-specific scope.'))
            else:
                lines.append(flag + ': not established by available declarations. It may be a bundled option, a literal value, or undocumented; support is uncertain.')
        if not supplied_flags and record.get('actions'):
            lines.append('Documented subcommands: ' + ' '.join(record['actions'][:24]))
        if not supplied_flags and record.get('options'):
            lines.append('Documented options: ' + ' '.join(record['options'][:24]))
        if shell['completions'].get(name):
            lines.append('Shell completion metadata is available; native Tab preserves its command-specific behavior.')
        for argument in argv[offset + 1:]:
            # Only explicitly supplied path-like literals are checked. No
            # directory listing, file contents, globbing or credential reads.
            if argument.startswith(('/', './', '../')) and not parsed['warnings']:
                try:
                    if not Path(argument).exists():
                        lines.append('A literal path argument does not exist in the current directory context; it may be an intended output path.')
                    elif not os.access(argument, os.R_OK):
                        lines.append('A literal path argument is not readable with the current user permissions.')
                except (OSError, ValueError):
                    lines.append('A literal path could not be inspected with current permissions.')
        for redirection in segment['redirections']:
            operator = redirection['operator']
            if operator.endswith(('>&', '<&')):
                lines.append('Redirection ' + operator + ': duplicate or close a file descriptor; the target is a descriptor, not an output filename.')
            else:
                lines.append('Redirection ' + operator + ': the shell opens the target before running the command; sudo on the command does not elevate that open operation.')
            if '>' in operator and '>>' not in operator and '&' not in operator:
                lines.append('Output redirection may create or truncate its target; no files are opened by this assistant.')
        if argv[:offset] and argv[0] == 'sudo':
            lines.append('sudo changes command privileges subject to policy; permissions are not bypassed by assistance.')
    if not segments:
        lines.append('Type a command, or use --intent with description words. This assistant works offline and never executes inspected commands.')
    if sensitive_line(line):
        lines.append('Possible credential arguments are not repeated in diagnostics or correction previews.')
    return result


def assist_main(argv):
    parser = argparse.ArgumentParser(prog='kythos-assist', description='Offline command inspection; no inspected command is executed.')
    modes = parser.add_mutually_exclusive_group()
    for name in ('explain', 'complete', 'intent', 'diagnose'):
        modes.add_argument('--' + name, dest='mode', action='store_const', const=name)
    parser.set_defaults(mode='explain')
    parser.add_argument('--status', type=int, help='explicit exit status for diagnosis')
    parser.add_argument('--json', action='store_true', help='machine-readable local result')
    parser.add_argument('line', nargs=argparse.REMAINDER, help='command line as a quoted string, or command and its arguments')
    options = parser.parse_args(argv)
    words = options.line[1:] if options.line[:1] == ['--'] else options.line
    line = words[0] if len(words) == 1 else shlex.join(words)
    result = assist(line, options.mode, options.status)
    render_assistance(result, options.json)
    return 0


def render_assistance(result, as_json=False):
    if as_json:
        print(json.dumps(result, ensure_ascii=True, sort_keys=True))
        return
    print(result['title'])
    for line in result['lines']:
        print(line)
    if result['candidates']:
        print('Candidates: ' + ' '.join(result['candidates']))
    if result['proposal'] and result['proposal'].get('command'):
        print('Proposed (review and type deliberately): ' + result['proposal']['command'])


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    if argv[:1] == ['--assist']:
        return assist_main(argv[1:])
    if argv in (['--assist-shell'], ['--assist-shell-json']):
        try:
            mode, status, line, context = context_protocol(sys.stdin.buffer.read(MAX_CONTEXT_BYTES + 1))
            render_assistance(assist(line, mode, status, context), argv == ['--assist-shell-json'])
            return 0
        except (ValueError, OSError, TypeError):
            print('KythOS assistance: local shell context is unavailable; native shell behavior is preserved.', file=sys.stderr)
            return 2
    if argv not in (['--json'], ['--shell'], ['--help-line'], ['--refresh-index']):
        print('Usage: kythos-command-suggest --json | --shell | --help-line < command-line; --refresh-index', file=sys.stderr)
        return 2
    try:
        if argv == ['--refresh-index']:
            value = refresh_command_index()
            print('KythOS command index: ' + str(len(value['commands'])) + ' installed executables.')
            return 0
        raw = sys.stdin.buffer.read(MAX_INPUT_BYTES + 1)
        if len(raw) > MAX_INPUT_BYTES:
            raise ValueError('phrase is too long')
        phrase = raw.decode('utf-8', errors='strict')
        if argv == ['--help-line']:
            parsed = parse_shell_line(phrase.rstrip('\r\n'))
            first = parsed['segments'][0]['argv'] if parsed['segments'] else []
            offset = command_offset(first, parsed['segments'][0]['quoted']) if first else 0
            if (parsed['warnings'] or len(parsed['segments']) > 1 or
                    len(first) > offset and resolve_command(first[offset])):
                render_assistance(assist(phrase.rstrip('\r\n')))
            else:
                print(command_help(phrase))
            return 0
        result = suggest(phrase, load_catalogue())
    except (ValueError, OSError, KeyError, TypeError) as exc:
        # Error classes are useful; input and filesystem details stay private.
        message = str(exc) if isinstance(exc, ValueError) and not isinstance(exc, json.JSONDecodeError) else 'suggestions are unavailable'
        print('KythOS suggestions: ' + message, file=sys.stderr)
        return 2
    if argv == ['--shell']:
        print((result['command'] or '') if result else '')
        print(result['message'] if result else '')
        print(result['kind'] if result else 'none')
    elif result is not None:
        print(json.dumps(result, ensure_ascii=True, sort_keys=True))
    return 0 if result is not None else 1


if __name__ == '__main__':
    raise SystemExit(main())
