#!/bin/sh
# Inspect local documentation; never execute the command being described.
set -eu
if test "$#" -eq 0 || test "${1-}" = --help || test "${1-}" = -h; then
    printf '%s\n' 'Usage: kythos-help command [arguments] | words describing a command' \
        'In interactive Bash, F1 shows contextual help for the current line.'
    exit 0
fi
# Each word is data. The engine accepts only literal command-line text.
printf '%s\n' "$*" | /usr/local/libexec/kythos-command-suggest --help-line
