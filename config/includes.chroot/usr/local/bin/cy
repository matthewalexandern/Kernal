#!/bin/sh
set -eu

show_help()
{
    cat <<'HELP'
Usage: cy [options] command

KythOS Kernal package management

Find and inspect packages:
  cy search words
  cy show package-name
  cy list --installed

Manage system packages with administrator permission:
  sudo cy update
  sudo cy install package-name
  sudo cy upgrade
  sudo cy full-upgrade
  sudo cy remove package-name
  sudo cy autoremove

Use cy help or cy --help to show this page. In an authenticated root shell,
omit sudo. Other supported package commands pass through to packaged APT.
Repository identities, package provenance, and backend version output remain
available. Package-authentication bypasses and unverified local packages are
outside this guarded command.
HELP
}

blocked_option()
{
    printf 'cy: refusing unsafe APT override: %s\n' "$1" >&2
    exit 2
}

blocked_operand()
{
    printf 'cy: refusing unauthenticated local package or URI operand: %s\n' "$1" >&2
    exit 2
}

if test "${APT_CONFIG+x}" = x; then
    blocked_option 'APT_CONFIG environment variable'
fi

for argument do
    normalized_argument=$(printf '%s' "$argument" | tr '[:upper:]' '[:lower:]')
    case "$normalized_argument" in
        --allow-unauthenticated|--allow-unauthenticated=*|\
        --allow-insecure-repositories|--allow-insecure-repositories=*|\
        --force-yes|--force-yes=*|\
        --allow-remove-essential|--allow-remove-essential=*|\
        --allow-change-held-packages|--allow-change-held-packages=*)
            blocked_option "$argument"
            ;;
        --with-source|--with-source=*)
            # APT can use local Packages or .changes metadata supplied through
            # this option and then install the referenced unsigned packages.
            blocked_option "$argument"
            ;;
        -c|--config-file|-c?*|--config-file=*|\
        -o|--option|-o?*|--option=*|-[!-]*[co]*)
            # A custom APT configuration can re-enable unauthenticated
            # packages indirectly. APT also accepts c and o inside clustered
            # short options, so reject those letters anywhere in a cluster.
            # Keep all configuration injection on the underlying apt command,
            # outside the guarded operator command.
            blocked_option "$argument"
            ;;
        /*|./*|../*|~/*|file:*|copy:*|*://*|*.deb|*.ddeb|*.udeb)
            # APT authenticates repository packages through signed metadata,
            # but a local package path can execute unverified maintainer
            # scripts as root. Keep that workflow outside this guarded
            # repository-only command.
            blocked_operand "$argument"
            ;;
    esac
done

if test "$#" -eq 0 || test "${1-}" = help; then
    show_help
    exit 0
fi
for argument do
    case "$argument" in
        -h|--help) show_help; exit 0 ;;
    esac
done

exec /usr/bin/apt "$@"
