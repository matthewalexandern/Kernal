# KythOS Kernal white shield boot theme.
# Esc retains Plymouth's standard switch to detailed boot output. Do not
# install a keyboard callback that consumes Esc or encrypted-volume input.
# A received boot progress value drives the bar. With no new progress for
# five seconds, a moving segment indicates activity without inventing percent.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);
logo.original = Image("kythos-logo.png");
logo.sprite = Sprite();
logo.sprite.SetZ(10);
logo.window_width = 0;
logo.window_height = 0;
ui.mode = "normal";
animation.frame = 0;
animation.progress = 0;
animation.last_progress_frame = -1000;

bar.background = Sprite();
bar.background.SetZ(5);
bar.fill = Sprite();
bar.fill.SetZ(6);
wordmark.image = Image.Text("KythOS Kernal™ 2027", 1, 1, 1, 1, "DejaVu Sans 10");
website.image = Image.Text("https://kythos.ai", 1, 1, 1, 1, "DejaVu Sans 9");
wordmark.sprite = Sprite(wordmark.image);
website.sprite = Sprite(website.image);
prompt.sprite = Sprite();
prompt.sprite.SetZ(100);
answer.sprite = Sprite();
answer.sprite.SetZ(101);
message.sprite = Sprite();
message.sprite.SetZ(102);

fun place_wordmark()
  {
    margin = Math.Max(12, Math.Int(Window.GetWidth() * 0.025));
    right = Window.GetX() + Window.GetWidth() - margin;
    bottom = Window.GetY() + Window.GetHeight() - margin;
    website.sprite.SetPosition(right - website.image.GetWidth(),
                               bottom - website.image.GetHeight(), 30);
    wordmark.sprite.SetPosition(right - wordmark.image.GetWidth(),
                                bottom - website.image.GetHeight() -
                                wordmark.image.GetHeight() - 6, 30);
  }

fun prepare_logo()
  {
    if (logo.window_width != Window.GetWidth() ||
        logo.window_height != Window.GetHeight())
      {
        logo.height = Math.Max(1, Math.Int(Window.GetHeight() * 0.48));
        logo.width = Math.Max(1, Math.Int(logo.height *
                                        logo.original.GetWidth() /
                                        logo.original.GetHeight()));
        if (logo.width > Window.GetWidth() * 0.45)
          {
            logo.width = Math.Max(1, Math.Int(Window.GetWidth() * 0.45));
            logo.height = Math.Max(1, Math.Int(logo.width *
                                             logo.original.GetHeight() /
                                             logo.original.GetWidth()));
          }
        logo.sprite.SetImage(logo.original.Scale(logo.width, logo.height));
        bar.width = Math.Max(60, Math.Int(Window.GetWidth() * 0.24));
        bar.track = Image("progress-track.png").Scale(bar.width, 3);
        bar.solid = Image("progress-fill.png").Scale(bar.width, 3);
        bar.background.SetImage(bar.track);
        logo.window_width = Window.GetWidth();
        logo.window_height = Window.GetHeight();
      }
    center_y = Window.GetY() + Window.GetHeight() * 0.46;
    if (ui.mode != "normal")
      center_y = Window.GetY() + Window.GetHeight() * 0.34;
    logo.sprite.SetPosition(Window.GetX() + (Window.GetWidth() - logo.width) / 2,
                            center_y - logo.height / 2, 10);
    bar.x = Window.GetX() + (Window.GetWidth() - bar.width) / 2;
    bar.y = Window.GetY() + Window.GetHeight() * 0.78;
    bar.background.SetPosition(bar.x, bar.y, 5);
    place_wordmark();
  }

fun show_progress()
  {
    if (ui.mode != "normal")
      {
        bar.background.SetOpacity(0);
        bar.fill.SetOpacity(0);
      }
    else
      {
        bar.background.SetOpacity(1);
        bar.fill.SetOpacity(1);
        if (animation.progress > 0 &&
            animation.frame - animation.last_progress_frame < 150)
          {
            width = Math.Max(1, Math.Int(bar.width * animation.progress));
            bar.fill.SetImage(bar.solid.Crop(0, 0, width, 3));
            bar.fill.SetPosition(bar.x, bar.y, 6);
          }
        else
          {
            # Indeterminate activity, never a simulated completion percentage.
            segment = Math.Max(1, Math.Int(bar.width * 0.20));
            phase = (Math.Sin(animation.frame * 0.045) + 1) / 2;
            bar.fill.SetImage(bar.solid.Crop(0, 0, segment, 3));
            bar.fill.SetPosition(bar.x + (bar.width - segment) * phase, bar.y, 6);
          }
      }
  }

fun center_sprite(sprite, image, y)
  {
    sprite.SetImage(image);
    sprite.SetPosition(Window.GetX() + (Window.GetWidth() - image.GetWidth()) / 2,
                        y, 100);
  }

fun place_prompt()
  {
    if (prompt.image)
      center_sprite(prompt.sprite, prompt.image,
                     Window.GetY() + Window.GetHeight() * 0.68);
    if (answer.image)
      center_sprite(answer.sprite, answer.image,
                     Window.GetY() + Window.GetHeight() * 0.75);
    if (message.image)
      center_sprite(message.sprite, message.image,
                     Window.GetY() + Window.GetHeight() * 0.84);
  }

fun refresh_callback()
  {
    prepare_logo();
    show_progress();
    place_prompt();
    animation.frame++;
  }

fun display_normal_callback()
  {
    global.ui.mode = "normal";
    prompt.sprite.SetOpacity(0);
    answer.sprite.SetOpacity(0);
  }

fun display_password_callback(text, bullets)
  {
    global.ui.mode = "password";
    prompt.image = Image.Text(text, 1, 1, 1);
    answer.text = "";
    for (index = 0; index < bullets; index++)
      answer.text += "*";
    answer.image = Image.Text(answer.text, 1, 1, 1);
    prompt.sprite.SetOpacity(1);
    answer.sprite.SetOpacity(1);
    prepare_logo();
    place_prompt();
  }

fun display_question_callback(text, entry)
  {
    global.ui.mode = "question";
    prompt.image = Image.Text(text, 1, 1, 1);
    answer.image = Image.Text(entry, 1, 1, 1);
    prompt.sprite.SetOpacity(1);
    answer.sprite.SetOpacity(1);
    prepare_logo();
    place_prompt();
  }

fun display_message_callback(text)
  {
    # Functional messages remain visible; ordinary service logs stay behind Esc.
    message.image = Image.Text(text, 1, 1, 1, 1, "DejaVu Sans 10");
    message.sprite.SetOpacity(1);
    place_prompt();
  }

fun hide_message_callback(text)
  {
    message.sprite.SetOpacity(0);
  }

fun progress_callback(duration, progress)
  {
    if (progress > animation.progress)
      {
        animation.progress = Math.Clamp(progress, 0, 1);
        animation.last_progress_frame = animation.frame;
      }
  }

fun quit_callback()
  {
    bar.fill.SetOpacity(0);
    bar.background.SetOpacity(0);
  }

Plymouth.SetRefreshRate(30);
Plymouth.SetRefreshFunction(refresh_callback);
Plymouth.SetBootProgressFunction(progress_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);
Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);
Plymouth.SetQuitFunction(quit_callback);
