+// KythOS validates only boot/encryption invariants, keeping native layout choices.
+// The model is still an in-memory proposal here; no disk jobs have run.
+struct KythosEncryptionState
+{
+    bool dependsOnCrypto = false;
+    bool fullyEncrypted = false;
+    bool known = true;
+    QStringList mappers;
+};
+
+static KythosEncryptionState
+kythosEncryptionState( const PartitionCoreModule* core, const Partition* partition, QSet< const Partition* > ancestors = {} )
+{
+    if ( !partition || ancestors.contains( partition ) ) return { false, false, false, {} };
+    ancestors.insert( partition );
+    const auto type = partition->fileSystem().type();
+    if ( type == FileSystem::Luks || type == FileSystem::Luks2 )
+    {
+        const auto* luks = dynamic_cast< const FS::luks* >( &partition->fileSystem() );
+        if ( !luks ) return { true, true, false, {} };
+        // A newly proposed LUKS volume has no UUID or mapper yet. Its disk and
+        // first sector identify the proposal without accessing any passphrase.
+        const QString identity = partition->devicePath() + ':' + QString::number( partition->firstSector() );
+        return { true, true, true, { identity } };
+    }
+    auto* devices = core->deviceModel();
+    for ( int i = 0; i < devices->rowCount(); ++i )
+    {
+        Device* device = devices->deviceForIndex( devices->index( i ) );
+        if ( device->deviceNode() != partition->devicePath() ) continue;
+        const auto* volumeGroup = dynamic_cast< const LvmDevice* >( device );
+        if ( !volumeGroup ) return {};
+        const auto physicalVolumes = core->proposedPhysicalVolumes( volumeGroup );
+        if ( physicalVolumes.isEmpty() ) return { false, false, false, {} };
+        KythosEncryptionState state { false, true, true, {} };
+        for ( const auto* pv : physicalVolumes )
+        {
+            const auto backing = kythosEncryptionState( core, pv, ancestors );
+            state.dependsOnCrypto = state.dependsOnCrypto || backing.dependsOnCrypto;
+            state.fullyEncrypted = state.fullyEncrypted && backing.fullyEncrypted;
+            state.known = state.known && backing.known;
+            state.mappers.append( backing.mappers );
+        }
+        state.mappers.removeDuplicates();
+        return state;
+    }
+    return {};
+}
+
+static QString
+kythosStorageLayoutError( const PartitionCoreModule* core )
+{
+    const Partition* root = core->findPartitionByMountPoint( "/" );
+    const Partition* boot = core->findPartitionByMountPoint( "/boot" );
+    if ( !root ) return QString();  // Native validation already requires root.
+    const auto rootState = kythosEncryptionState( core, root );
+    const auto bootState = boot ? kythosEncryptionState( core, boot ) : KythosEncryptionState();
+    bool plaintextSwap = false;
+    bool knownSwap = true;
+    QStringList swapBackingIdentities;
+    auto* devices = core->deviceModel();
+    for ( int i = 0; i < devices->rowCount(); ++i )
+    {
+        Device* device = devices->deviceForIndex( devices->index( i ) );
+        using Calamares::Partition::PartitionIterator;
+        for ( auto it = PartitionIterator::begin( device ); it != PartitionIterator::end( device ); ++it )
+        {
+            // Match fstab's claimed-swap semantics; untouched foreign swap is not used.
+            if ( PartitionInfo::format( *it ) && ( *it )->fileSystem().type() == FileSystem::LinuxSwap )
+            {
+                const auto swapState = kythosEncryptionState( core, *it );
+                plaintextSwap = plaintextSwap || !swapState.fullyEncrypted;
+                knownSwap = knownSwap && swapState.known;
+                swapBackingIdentities.append( swapState.mappers );
+            }
+        }
+    }
+    if ( !rootState.known || !bootState.known || !knownSwap )
+        return QObject::tr( "The encryption backing of this proposed volume group could not be determined. "
+                            "Review its physical volumes before continuing; no disk changes have been made." );
+    auto* gs = Calamares::JobQueue::instance()->globalStorage();
+    gs->insert( "kythosRootBackingIdentities", rootState.mappers );
+    gs->insert( "kythosRootFullyEncrypted", rootState.fullyEncrypted );
+    swapBackingIdentities.removeDuplicates();
+    gs->insert( "kythosSwapBackingIdentities", swapBackingIdentities );
+    const auto issue = KythosStoragePolicy::validate( rootState.dependsOnCrypto, boot != nullptr,
+                                                    bootState.dependsOnCrypto, plaintextSwap );
+    switch ( issue )
+    {
+    case KythosStoragePolicy::Issue::EncryptedBoot:
+        return QObject::tr( "The supported signed GRUB chain requires an unencrypted boot filesystem. "
+                            "Make /boot unencrypted, or use an unencrypted root that contains its boot files." );
+    case KythosStoragePolicy::Issue::MissingPublicBoot:
+        return QObject::tr( "Root depends on encrypted storage and requires a separate unencrypted /boot partition. "
+                            "Create or select /boot before continuing; its size is your choice." );
+    case KythosStoragePolicy::Issue::PlaintextSwap:
+        return QObject::tr( "Root encryption also requires encrypted swap. Encrypt or remove the selected "
+                            "swap partition, or choose a swap file inside encrypted root." );
+    case KythosStoragePolicy::Issue::None:
+        return QString();
+    }
+    return QString();
+}
+
+static void
+kythosShowStorageWarning( QWidget* page, const QString& message )
+{
+    if ( !page || !page->layout() )
+    {
+        return;
+    }
+    auto* label = page->findChild< QLabel* >( QStringLiteral( "kythosStorageWarning" ), Qt::FindDirectChildrenOnly );
+    if ( !label )
+    {
+        label = new QLabel( page );
+        label->setObjectName( QStringLiteral( "kythosStorageWarning" ) );
+        label->setWordWrap( true );
+        label->setTextFormat( Qt::PlainText );
+        label->setStyleSheet( QStringLiteral( "color: #b42318; padding: 6px;" ) );
+        page->layout()->addWidget( label );
+    }
+    label->setText( message );
+    label->setVisible( !message.isEmpty() );
+}
+
+class KythosStorageGuardJob : public Calamares::CppJob
+{
+public:
+    explicit KythosStorageGuardJob( const QString& message ) : m_message( message ) {}
+    QString prettyName() const override { return QObject::tr( "Validate the proposed storage layout" ); }
+    Calamares::JobResult exec() override
+    {
+        return Calamares::JobResult::error( QObject::tr( "The proposed storage layout cannot boot safely" ), m_message );
+    }
+private:
+    QString m_message;
+};
