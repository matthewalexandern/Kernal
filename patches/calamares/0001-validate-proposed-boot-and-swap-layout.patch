+namespace KythosStoragePolicy
+{
+enum class Issue { None, EncryptedBoot, MissingPublicBoot, PlaintextSwap };
+
+// Filesystem sizes and native guided/manual choices are intentionally absent.
+// A plain root may contain /boot. An encrypted root needs public boot files.
+inline Issue validate( bool rootEncrypted, bool separateBoot, bool bootEncrypted, bool plaintextClaimedSwap )
+{
+    if ( bootEncrypted ) return Issue::EncryptedBoot;
+    if ( rootEncrypted && !separateBoot ) return Issue::MissingPublicBoot;
+    if ( rootEncrypted && plaintextClaimedSwap ) return Issue::PlaintextSwap;
+    return Issue::None;
+}
+}
