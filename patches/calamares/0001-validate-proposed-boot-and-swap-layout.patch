+QVector< const Partition* >
+PartitionCoreModule::proposedPhysicalVolumes( const LvmDevice* device ) const
+{
+    const auto* info = infoForDevice( device );
+    if ( info )
+    {
+        const auto& pending = info->jobs();
+        for ( auto it = pending.crbegin(); it != pending.crend(); ++it )
+        {
+            if ( const auto* resize = dynamic_cast< const ResizeVolumeGroupJob* >( it->data() ) )
+                return resize->proposedPhysicalVolumes();
+            if ( const auto* create = dynamic_cast< const CreateVolumeGroupJob* >( it->data() ) )
+                return create->proposedPhysicalVolumes();
+        }
+    }
+    return device->physicalVolumes();
+}
